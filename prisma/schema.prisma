  MEDICINE_RETAILER
  OTHER
}

enum CallOutcome {
  NOT_CALLED
  NO_ANSWER
  BUSY
  CONNECTED
  INTERESTED
  NOT_INTERESTED
  WRONG_NUMBER
  FOLLOW_UP_REQUIRED
  DEMO_SCHEDULED
  CONVERTED
  DO_NOT_CONTACT
}

model GrowthTeam {
  id        String         @id @default(uuid())
  name      String         @unique
  managerId String? // StaffUser id of the marketing manager
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  members   GrowthMember[]
}

/// A staff member's Growth Intelligence role (GrowthEmployee). Super admins are Growth admins without a row.
model GrowthMember {
  id        String      @id @default(uuid())
  staffId   String      @unique
  staff     StaffUser   @relation(fields: [staffId], references: [id])
  role      GrowthRole
  teamId    String?
  team      GrowthTeam? @relation(fields: [teamId], references: [id])
  active    Boolean     @default(true)
  addedBy   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model EmployeeTerritory {
  id        String    @id @default(uuid())
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id])
  state     String
  district  String    @default("")
  pin       String    @default("")
  createdBy String
  createdAt DateTime  @default(now())

  @@unique([staffId, state, district, pin])
  @@index([state, district, pin])
}

model EmployeeCallingTarget {
  id            String    @id @default(uuid())
  staffId       String
  staff         StaffUser @relation(fields: [staffId], references: [id])
  period        String // daily, weekly
  calls         Int // reported call attempts
  connected     Int       @default(0)
  conversions   Int       @default(0)
  effectiveFrom DateTime  @db.Date
  setBy         String
  createdAt     DateTime  @default(now())

  @@index([staffId, period, effectiveFrom])
}

/// Daily roll-up written by the background job; dashboards read live data, this keeps history cheap to chart.
model EmployeeDailyPerformance {
  id          String   @id @default(uuid())
  staffId     String
  day         DateTime @db.Date
  launches    Int      @default(0)
  reported    Int      @default(0)
  connected   Int      @default(0)
  interested  Int      @default(0)
  demos       Int      @default(0)
  conversions Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([staffId, day])
}

model LeadSource {
  id           String         @id @default(uuid())
  key          String         @unique
  name         String
  kind         String // open_data, public_directory, official_api, provider, upload, submitted, manual
  licence      String         @default("")
  attribution  String         @default("")
  termsUrl     String         @default("")
  allowsExport Boolean        @default(true)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        PharmacyLead[]
}

model PharmacyLead {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  nameKey            String // normalised for duplicate matching
  category           LeadCategory      @default(RETAIL)
  ownerName          String            @default("")
  ownerVerified      Boolean           @default(false)
  phone              String? // E.164, e.g. +919876543210
  phoneRaw           String            @default("")
  email              String            @default("")
  website            String            @default("")
  domain             String            @default("")
  address            String            @default("")
  state              String            @default("")
  district           String            @default("")
  city               String            @default("")
  pin                String            @default("")
  lat                Float?
  lng                Float?
  sourceId           String?
  source             LeadSource?       @relation(fields: [sourceId], references: [id])
  sourceRef          String            @default("") // the record's id at the source, e.g. osm:node/123
  sourceUrl          String            @default("")
  collectedAt        DateTime          @default(now())
  verification       LeadVerification  @default(UNVERIFIED)
  businessVerifiedAt DateTime?
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  websiteVerifiedAt  DateTime?
  locationVerifiedAt DateTime?
  invalidReason      String?
  duplicateOfId      String?
  possibleDuplicate  Boolean           @default(false)
  score              Int               @default(0)
  scoredAt           DateTime?
  stage              LeadStage         @default(NEW_LEAD)
  lostReason         String?
  softwareStatus     String            @default("") // user-provided: none, paper, other_happy, other_unhappy
  assignedStaffId    String? // the active primary assignee (kept in step with LeadAssignment)
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  pipelineLeadId     String? // the staff pipeline Lead this was handed off to
  importJobId        String?
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  erasedAt           DateTime?
  contacts           PharmacyContact[]
  evidence           LeadEvidence[]
  assignments        LeadAssignment[]
  notes              LeadNote[]
  activities         LeadActivity[]
  calls              CallSession[]
  followUps          FollowUpTask[]
  scores             LeadScore[]

  @@index([state, district, city])
  @@index([pin])
  @@index([phone])
  @@index([domain])
  @@index([stage])
  @@index([verification])
  @@index([assignedStaffId])
  @@index([nextFollowUpAt])
  @@index([createdAt])
  @@index([sourceId, sourceRef])
}

model PharmacyContact {
  id          String       @id @default(uuid())
  leadId      String
  lead        PharmacyLead @relation(fields: [leadId], references: [id])
  name        String
  role        String       @default("owner") // owner, manager, pharmacist, other
  phone       String? // E.164
  email       String       @default("")
  provenance  String // verified, user_provided, source
  createdById String?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  @@index([leadId])
}

/// Why a fact about a lead is believed. Append-only: a failed or withdrawn check is a new row.
model LeadEvidence {
  id        String       @id @default(uuid())
  leadId    String
  lead      PharmacyLead @relation(fields: [leadId], references: [id])
  kind      String // business, phone, email, website, location, source, software
  method    String // call_confirmed, website_fetch, document, manual_review, email_reply, source_listing, call_report
  result    String // verified, failed, info, withdrawn
  detail    String
  url       String       @default("")
  byStaffId String?
  at        DateTime     @default(now())

  @@index([leadId, kind, at])
}

model LeadScore {
  id        String       @id @default(uuid())
  leadId    String
  lead      PharmacyLead @relation(fields: [leadId], references: [id])
  total     Int
  breakdown Json
  at        DateTime     @default(now())

  @@index([leadId, at])
}

model LeadImportJob {
  id                 String    @id @default(uuid())
  code               String    @unique
  fileName           String
  sourceId           String?
  status             String // running, completed, failed
  mapping            Json
  totalRows          Int       @default(0)
  created            Int       @default(0)
  duplicates         Int       @default(0)
  possibleDuplicates Int       @default(0)
  invalid            Int       @default(0)
  processed          Int       @default(0)
  errors             Json      @default("[]")
  rows               Json? // normalised rows still to process; cleared when the job finishes
  createdById        String
  createdAt          DateTime  @default(now())
  finishedAt         DateTime?
}

model LeadDuplicateCandidate {
  id        String    @id @default(uuid())
  leadId    String // the newer record
  matchId   String // the existing record it may duplicate
  reason    String
  score     Float
  status    String    @default("open") // open, merged, dismissed
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([leadId, matchId])
  @@index([status])
}

model LeadAssignment {
  id            String       @id @default(uuid())
  leadId        String
  lead          PharmacyLead @relation(fields: [leadId], references: [id])
  staffId       String
  staff         StaffUser    @relation(fields: [staffId], references: [id])
  primary       Boolean      @default(true)
  active        Boolean      @default(true)
  /// Set to leadId while this is the active primary assignment, NULL otherwise: one active primary per lead.
  activeLeadKey String?      @unique
  assignedById  String
  assignedAt    DateTime     @default(now())
  dueAt         DateTime?
  endedAt       DateTime?
  endedById     String?
  endReason     String?

  @@index([staffId, active])
  @@index([leadId])
}

/// Append-only log of assignment changes (assigned, reassigned, withdrawn).
model LeadAssignmentHistory {
  id          String   @id @default(uuid())
  leadId      String
  action      String
  fromStaffId String?
  toStaffId   String?
  byStaffId   String
  reason      String   @default("")
  at          DateTime @default(now())

  @@index([leadId, at])
}

model LeadNote {
  id        String       @id @default(uuid())
  leadId    String
  lead      PharmacyLead @relation(fields: [leadId], references: [id])
  staffId   String
  staffName String
  text      String
  at        DateTime     @default(now())
  deletedAt DateTime?

  @@index([leadId, at])
}

/// The lead's timeline. Append-only.
model LeadActivity {
  id        String       @id @default(uuid())
  leadId    String
  lead      PharmacyLead @relation(fields: [leadId], references: [id])
  kind      String // created, imported, assigned, call_launched, call_reported, stage, note, verified, follow_up, message, demo, conversion, merged, consent, erased
  text      String
  staffId   String?
  staffName String       @default("")
  refId     String?
  at        DateTime     @default(now())

  @@index([leadId, at])
}

model CallSession {
  id              String       @id @default(uuid())
  leadId          String
  lead            PharmacyLead @relation(fields: [leadId], references: [id])
  staffId         String
  staff           StaffUser    @relation(fields: [staffId], references: [id])
  assignmentId    String?
  phone           String // the E.164 number handed to the dialer
  launchedAt      DateTime     @default(now())
  status          String       @default("launched") // launched, reported
  reportedAt      DateTime?
  outcome         CallOutcome?
  interestLevel   String? // none, low, medium, high
  notes           String       @default("")
  numberConfirmed Boolean      @default(false) // the person who answered confirmed this is the pharmacy
  softwareStatus  String       @default("")
  demoRequested   Boolean      @default(false)
  followUpAt      DateTime?
  reportKey       String?      @unique // idempotency key of the report
  userAgent       String       @default("")

  @@index([staffId, launchedAt])
  @@index([leadId, launchedAt])
  @@index([reportedAt])
}

model FollowUpTask {
  id          String       @id @default(uuid())
  leadId      String
  lead        PharmacyLead @relation(fields: [leadId], references: [id])
  staffId     String
  staff       StaffUser    @relation(fields: [staffId], references: [id])
  dueAt       DateTime
  note        String       @default("")
  status      String       @default("open") // open, done, cancelled
  callId      String?
  createdById String
  createdAt   DateTime     @default(now())
  doneAt      DateTime?
  escalatedAt DateTime?

  @@index([staffId, status, dueAt])
  @@index([leadId, status])
}

model SalesDeal {
  id          String   @id @default(uuid())
  leadId      String   @unique
  staffId     String
  product     String
  cycle       String   @default("m")
  amountPaise Int      @default(0)
  status      String   @default("open") // open, won, lost
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DemoBooking {
  id          String    @id @default(uuid())
  leadId      String
  staffId     String
  at          DateTime
  mode        String    @default("phone") // phone, video, visit
  status      String    @default("scheduled") // scheduled, completed, no_show, cancelled
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([staffId, at])
  @@index([leadId])
}

model ConversionRecord {
  id          String   @id @default(uuid())
  leadId      String   @unique
  staffId     String
  product     String
  cycle       String   @default("m")
  amountPaise Int      @default(0)
  reference   String   @default("")
  notes       String   @default("")
  callId      String?
  at          DateTime @default(now())

  @@index([staffId, at])
}

model MessageTemplate {
  id        String   @id @default(uuid())
  channel   String // whatsapp, email
  name      String
  language  String   @default("en")
  category  String   @default("MARKETING") // WhatsApp: MARKETING, UTILITY
  subject   String   @default("")
  body      String
  status    String   @default("draft") // draft, pending, approved, rejected
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, name, language])
}

model SalesCampaign {
  id         String              @id @default(uuid())
  code       String              @unique
  name       String
  channel    String // whatsapp, email
  templateId String
  audience   Json // filters
  status     String              @default("draft") // draft, pending_approval, approved, running, completed, cancelled
  dailyCap   Int                 @default(200)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id         String        @id @default(uuid())
  campaignId String
  campaign   SalesCampaign @relation(fields: [campaignId], references: [id])
  leadId     String
  address    String // phone (E.164) or email
  status     String // queued, skipped, sent, delivered, read, replied, failed
  reason     String        @default("")
  providerId String?
  sentAt     DateTime?
  updatedAt  DateTime      @updatedAt

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([providerId])
}

model MessageConversation {
  id            String         @id @default(uuid())
  leadId        String?
  channel       String // whatsapp, email
  address       String // E.164 phone or email
  lastMessageAt DateTime       @default(now())
  lastInboundAt DateTime?
  unread        Int            @default(0)
  createdAt     DateTime       @default(now())
  events        MessageEvent[]

  @@unique([channel, address])
  @@index([leadId])
}

model MessageEvent {
  id             String              @id @default(uuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id])
  direction      String // out, in, status
  kind           String // text, template, status
  body           String              @default("")
  status         String              @default("") // queued, sent, delivered, read, failed, received
  providerId     String?
  staffId        String?
  campaignId     String?
  error          String?
  at             DateTime            @default(now())

  @@index([conversationId, at])
  @@index([providerId])
}

/// Consent to contact a lead on a channel for a purpose. Revocation keeps the row (revokedAt).
model ContactConsent {
  id          String    @id @default(uuid())
  leadId      String
  channel     String // phone, whatsapp, email, sms
  purpose     String // marketing, service
  scope       String    @default("") // what was agreed, in the contact's words where possible
  lawfulBasis String // consent, legitimate_use
  evidence    String // how it was obtained: call note, form, reply…
  source      String    @default("") // call, form, inbound, import
  grantedAt   DateTime  @default(now())
  recordedBy  String
  revokedAt   DateTime?
  revokedBy   String?
  revokeNote  String?

  @@index([leadId, channel, purpose])
}

/// Do-not-contact list. Keyed by a hash of the phone or email so it survives erasure of the lead.
model SuppressionRecord {
  id        String    @id @default(uuid())
  channel   String // all, phone, whatsapp, email
  valueHash String
  hint      String // masked value for people, e.g. +91•••••43210
  reason    String // dnc_request, opt_out, bounce, complaint, wrong_number, manual, erasure
  leadId    String?
  createdBy String
  createdAt DateTime  @default(now())
  liftedAt  DateTime?
  liftedBy  String?
  liftNote  String?

  @@index([valueHash])
}

model IntegrationConnection {
  id        String   @id @default(uuid())
  kind      String   @unique // whatsapp, email, osm
  status    String // connected, disconnected, error
  config    Json // non-secret settings
  secrets   Bytes? // sealed JSON with tokens
  lastError String?
  updatedBy String
  updatedAt DateTime @updatedAt
}

model BackgroundJob {
  id             String    @id @default(uuid())
  kind           String
  payload        Json
  status         String    @default("queued") // queued, running, done, failed, dead
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  idempotencyKey String?   @unique
  createdBy      String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([status, runAt])
}

model EventOutbox {
  id          String    @id @default(uuid())
  topic       String
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, createdAt])
}

/// Append-only audit trail of Growth Intelligence actions.
model GrowthAuditLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  staffId   String?
  staffName String
  action    String
  entity    String   @default("")
  entityId  String?
  detail    String   @default("")
  ip        String?
}

model GrowthSetting {
  key   String @id
  value Json
}

// ───────────────────────── Medoro HRMS (/staff/hrms) ─────────────────────────
// Medoro's own people records: attendance, leave, claims, payroll, tasks, projects, recruitment and the
// finance registers. Every employee is a StaffUser; HrProfile adds the HR side. Nothing links to pharmacy tables.

enum HrRole {
  employee
  hr
  admin
  finance
  sales
}

model HrProfile {
  staffId            String    @id
  staff              StaffUser @relation(fields: [staffId], references: [id])
  role               HrRole    @default(employee)
  dept               String    @default("")
  designation        String    @default("")
  empType            String    @default("Full-time")
  location           String    @default("")
  managerId          String?
  joinDate           DateTime? @db.Date
  ctc                Int       @default(0) // rupees per year
  incentivePct       Decimal   @default(0) @db.Decimal(4, 2)
  monthlyTarget      Int       @default(40) // pharmacies to win per month (sales)
  personalEmail      String    @default("")
  mustChangePassword Boolean   @default(false)
  profileDone        Boolean   @default(false)
  docsAcceptedAt     DateTime?
  dob                DateTime? @db.Date
  gender             String    @default("")
  address            String    @default("")
  emergencyName      String    @default("")
  emergencyPhone     String    @default("")
  bloodGroup         String    @default("")
  bankHolder         String    @default("")
  bankAccountSealed  Bytes?
  bankLast4          String    @default("")
  bankIfsc           String    @default("")
  bankName           String    @default("")
  panSealed          Bytes?
  panMasked          String    @default("")
  uan                String    @default("")
  photo              String? // small data: URL chosen by the employee
  presence           String    @default("offline") // active, break, offline
  presenceNote       String    @default("")
  presenceAt         DateTime?
  otpHash            String? // one-time password issued by HR (argon2)
  otpExpiresAt       DateTime?
  onboarding         Json      @default("[]") // checklist ticks for a new joiner
  leaveExtra         Json      @default("{}") // extra days granted per leave type, e.g. {"comp":1}
  createdAt          DateTime  @default(now())
}

model HrDepartment {
  id        String   @id @default(uuid())
  name      String   @unique
  headId    String?
  createdAt DateTime @default(now())
}

model HrAttendance {
  id       String    @id @default(uuid())
  staffId  String
  day      DateTime  @db.Date
  inAt     DateTime?
  outAt    DateTime?
  status   String // present, late, wfh, absent
  breakMin Int       @default(0)
  note     String    @default("")

  @@unique([staffId, day])
  @@index([day])
}

model HrBreak {
  id      String    @id @default(uuid())
  staffId String
  kind    String
  startAt DateTime  @default(now())
  endAt   DateTime?

  @@index([staffId, startAt])
}

model HrLeave {
  id        String    @id @default(uuid())
  staffId   String
  type      String // casual, sick, privilege, comp
  fromDay   DateTime  @db.Date
  toDay     DateTime  @db.Date
  days      Int
  reason    String    @default("")
  status    String    @default("pending") // pending, approved, rejected, cancelled
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId, fromDay])
  @@index([status])
}

model HrCorrection {
  id        String    @id @default(uuid())
  staffId   String
  day       DateTime  @db.Date
  reason    String
  status    String    @default("pending")
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
}

model HrClaim {
  id        String    @id @default(uuid())
  staffId   String
  type      String
  amount    Int // rupees
  note      String    @default("")
  billKey   String? // storage key of the uploaded bill
  billName  String    @default("")
  status    String    @default("pending_hr") // pending_hr, pending_admin, approved, rejected
  hrBy      String?
  adminBy   String?
  decidedAt DateTime?
  paidMonth String? // payroll month (YYYY-MM) the claim was paid with
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@index([status])
}

model HrHoliday {
  id   String   @id @default(uuid())
  day  DateTime @unique @db.Date
  name String
  kind String   @default("National holiday")
}

model HrAnnouncement {
  id        String   @id @default(uuid())
  emoji     String   @default("📢")
  title     String
  body      String
  byId      String
  createdAt DateTime @default(now())
}

model HrProject {
  id        String    @id @default(uuid())
  name      String
  client    String    @default("Internal")
  leadId    String?
  members   String[]
  deadline  DateTime? @db.Date
  status    String    @default("Planning") // Planning, In progress, On hold, Done
  createdAt DateTime  @default(now())
  tasks     HrTask[]
}

model HrTask {
  id         String     @id @default(uuid())
  kind       String     @default("task") // task (assigned work) or reminder (personal)
  title      String
  assigneeId String
  byId       String
  due        DateTime?  @db.Date
  priority   String     @default("Medium") // High, Medium, Low
  status     String     @default("open") // open, done
  col        String     @default("todo") // board column: backlog, todo, progress, review, done
  projectId  String?
  project    HrProject? @relation(fields: [projectId], references: [id])
  comment    String     @default("")
  doneAt     DateTime?
  createdAt  DateTime   @default(now())

  @@index([assigneeId, status])
  @@index([projectId])
}

model HrPayslip {
  id        String    @id @default(uuid())
  staffId   String
  month     String // YYYY-MM
  workDays  Int
  lopDays   Int       @default(0)
  basic     Int
  hra       Int
  special   Int
  incentive Int       @default(0)
  reimburse Int       @default(0)
  gross     Int
  pf        Int
  esi       Int
  pt        Int
  tds       Int
  lop       Int       @default(0)
  net       Int
  status    String    @default("pending") // pending, paid
  paidOn    DateTime? @db.Date
  runBy     String
  createdAt DateTime  @default(now())

  @@unique([staffId, month])
  @@index([month])
}

model HrJob {
  id         String        @id @default(uuid())
  title      String
  dept       String
  location   String
  type       String
  status     String        @default("active") // active, closed
  createdAt  DateTime      @default(now())
  candidates HrCandidate[]
}

model HrCandidate {
  id         String   @id @default(uuid())
  jobId      String?
  job        HrJob?   @relation(fields: [jobId], references: [id])
  name       String
  email      String   @default("")
  phone      String   @default("")
  role       String
  note       String   @default("")
  score      Int? // screening score out of 100, entered by HR
  stage      String   @default("applied") // applied, interview, offer, hired, rejected
  offer      Json? // the offer letter fields once generated
  referredBy String?
  createdAt  DateTime @default(now())

  @@index([stage])
}

model HrTicket {
  id         String    @id @default(uuid())
  code       String    @unique
  staffId    String
  category   String
  subject    String
  body       String
  status     String    @default("open") // open, resolved
  reply      String    @default("")
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([staffId])
}

model HrMeeting {
  id        String   @id @default(uuid())
  title     String
  at        DateTime
  minutes   Int      @default(30)
  link      String   @default("")
  byId      String
  attendees String[]
  notes     String   @default("") // minutes of the meeting
  createdAt DateTime @default(now())

  @@index([at])
}

model HrRecognition {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  badge     String   @default("🌟")
  note      String
  createdAt DateTime @default(now())

  @@index([toId])
}

model HrNotification {
  id        String    @id @default(uuid())
  staffId   String
  text      String
  screen    String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId, readAt])
}

model HrAllyUsage {
  staffId String
  day     DateTime @db.Date
  prompts Int      @default(0)
  chars   Int      @default(0)

  @@id([staffId, day])
}

/// Finance registers (contacts, invoices, bills, journals, products, bank accounts…): one row per record,
/// `kind` names the register and `data` holds its columns.
model HrRecord {
  id        String   @id @default(uuid())
  kind      String
  data      Json
  byId      String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model HrSetting {
  key   String @id
  value Json
}
