// Medoro — PostgreSQL 16. Based on design/schema.reference.prisma.
// Money is BigInt paise. Posted rows (movements, ledger, audit) are append-only:
// DB triggers in the init migration block UPDATE/DELETE on them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  ok
  quarantine
  damaged
  recalled
}

enum PoStatus {
  draft
  ordered
  partially_received
  received
  cancelled
  closed // short-closed: the remaining quantity is no longer expected
}

enum PayMode {
  cash
  upi
  card
  credit
  split
  cod // cash on delivery: with the delivery person until handed over (docs/ORDERS_AND_DELIVERY.md)
  loyalty // points redeemed at the counter (see LoyaltyLedger)
}

enum MsgStatus {
  queued
  sent
  delivered
  read
  failed
}

enum VoucherType {
  receipt
  payment
  journal
  credit_note
  debit_note
  reversal
  sales
  purchase
}

// ───────────── Tenancy & identity ─────────────

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique // pharmacy code staff type at employee login, e.g. SANJ-PUNE
  name      String
  legalName String?
  gstin     String?
  phone     String?
  createdAt DateTime @default(now())
  branches  Branch[]
  users     User[]
  roles     Role[]
  settings  Json     @default("{}")
}

model Branch {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  code        String // short code used in invoice numbers, e.g. KOT
  address     String?
  gstin       String?
  drugLicence String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  permissions String[]
  locked      Boolean  @default(false)
  users       User[]

  @@unique([tenantId, name])
}

model User {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  name            String
  email           String?
  phone           String?
  passwordHash    String?
  employeeNo      String? // E-101; used with pharmacy code + PIN at counters
  pinHash         String?
  mfaSecret       String?
  mfaRequired     Boolean        @default(false)
  mfaEnabled      Boolean        @default(false)
  tokenVersion    Int            @default(0)
  active          Boolean        @default(true)
  roleId          String
  role            Role           @relation(fields: [roleId], references: [id])
  branchIds       String[] // empty = all branches
  lastLoginAt     DateTime?
  failedLogins    Int            @default(0)
  lockedUntil     DateTime?
  isSupport       Boolean        @default(false) // the read-only "Medoro support" login an owner can grant
  googleSub       String?        @unique // linked "Sign in with Google" account (OIDC subject)
  googleEmail     String?
  passwordResetAt DateTime? // last forgot-password reset; holds back an OTP-only MFA reset for 24 h
  permGrants      String[]       @default([]) // permissions granted to this user on top of the role
  permRevokes     String[]       @default([]) // role permissions withheld from this user
  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  authCodes       AuthCode[]
  createdAt       DateTime       @default(now())

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([tenantId, employeeNo])
}

model Invite {
  id        String    @id @default(uuid())
  tenantId  String
  code      String    @unique // e.g. 7Q4K-29, valid 48 h
  name      String?
  contact   String // email or mobile
  roleName  String
  branchId  String?
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
}

model Counter {
  id       String  @id @default(uuid())
  tenantId String
  branchId String
  name     String
  active   Boolean @default(true)

  @@unique([branchId, name])
}

// Sign-in throttling per account+IP key.
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// One-time MFA recovery codes, stored as hashes. Shown once at enrolment or regeneration.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use codes sent by email or SMS for password reset and lost-authenticator recovery.
model AuthCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // reset, mfa-reset
  channel   String // email, sms
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// Fixed-window request counters for expensive or abusable actions (src/server/ratelimit.ts).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

model Session {
  id           String    @id // sha256 of the cookie token
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenVersion Int
  device       String?
  counterId    String?
  mfaPassed    Boolean   @default(false)
  firstFactor  String? // password, google, otp or pin: what this sign-in proved before MFA
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
}

// Generic per-tenant counters: invoice numbers, voucher numbers, PO/GRN numbers.
model Sequence {
  tenantId String
  key      String // e.g. "INV:<branchId>:2627", "RV", "PO:2627"
  next     Int    @default(1)

  @@id([tenantId, key])
}

// ───────────── Catalogue & inventory ─────────────

model Medicine {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  generic      String
  strength     String
  form         String
  manufacturer String
  pack         String
  unitsPerPack Int            @default(1)
  barcode      String?
  hsn          String
  gstRate      Int
  mrpPaise     BigInt
  schedule     String? // H, H1, X or null
  reorderLevel Int            @default(0)
  rack         String?
  composition  String? // salts with strengths, e.g. "Paracetamol 500mg + Caffeine 25mg"
  saltKey      String? // order-independent normalised composition; equal keys are substitutes
  packSize     Int            @default(1) // stock units in one MRP pack; batch quantities are in stock units
  packUnit     String         @default("pack") // what one MRP pack is called: strip, bottle
  looseUnit    String         @default("unit") // the stock unit when sold loose: tab, cap
  allowLoose   Boolean        @default(false)
  caseSize     Int            @default(1) // packs in one purchase case
  caseUnit     String         @default("box")
  active       Boolean        @default(true)
  version      Int            @default(0)
  createdAt    DateTime       @default(now())
  batches      Batch[]
  racks        MedicineRack[]

  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, generic])
  @@index([tenantId, saltKey])
}

// Branch-specific shelf location; falls back to Medicine.rack.
model MedicineRack {
  tenantId   String
  branchId   String
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  rack       String
  updatedAt  DateTime @updatedAt

  @@id([branchId, medicineId])
  @@index([tenantId, branchId, rack])
}

model Doctor {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  qualification String?
  regNo         String? // State Medical Council / NMC registration number
  clinic        String?
  phone         String?
  address       String?
  active        Boolean  @default(true)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  sales         Sale[]

  @@unique([tenantId, regNo])
  @@index([tenantId, name])
}

model Batch {
  id             String          @id @default(uuid())
  tenantId       String
  branchId       String
  medicineId     String
  medicine       Medicine        @relation(fields: [medicineId], references: [id])
  batchNo        String
  mfgDate        DateTime?       @db.Date
  expiryDate     DateTime        @db.Date
  qtyAvailable   Int
  qtyQuarantined Int             @default(0)
  costPaise      BigInt
  mrpPaise       BigInt
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  grnId          String?
  status         BatchStatus     @default(ok)
  statusNote     String?
  version        Int             @default(0)
  createdAt      DateTime        @default(now())
  movements      StockMovement[]

  @@unique([tenantId, branchId, medicineId, batchNo])
  @@index([branchId, medicineId, expiryDate])
}

model StockMovement {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  batchId  String
  batch    Batch    @relation(fields: [batchId], references: [id])
  qty      Int
  type     String // sale, return, grn, adjust, count, transfer_out, transfer_in, quarantine, release, opening
  refType  String
  refId    String
  userId   String
  at       DateTime @default(now())
  note     String?

  @@index([batchId, at])
  @@index([tenantId, refType, refId])
  @@index([tenantId, branchId, at])
}

model StockCount {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  no       String
  userId   String
  at       DateTime @default(now())
  lines    Json // [{batchId, system, counted, valuePaise}]
  note     String?
}

model Transfer {
  id         String    @id @default(uuid())
  tenantId   String
  no         String
  fromBranch String
  toBranch   String
  batchId    String
  qty        Int
  status     String // pending, in_transit, received, rejected
  createdBy  String
  createdAt  DateTime  @default(now())
  approvedBy String?
  approvedAt DateTime?
  receivedBy String?
  receivedAt DateTime?
  note       String?

  @@unique([tenantId, no])
}

// Goods returned to a supplier (debit note) or written off.
model StockOut {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  no         String
  kind       String // supplier_return, write_off
  supplierId String?
  batchId    String
  qty        Int
  valuePaise BigInt
  reason     String
  userId     String
  at         DateTime @default(now())

  @@unique([tenantId, no])
}

// Expiry / breakage claim on a supplier: stock leaves at once; the payable drops only when their credit note arrives.
model SupplierClaim {
  id             String    @id @default(uuid())
  tenantId       String
  branchId       String
  no             String
  supplierId     String
  batchId        String
  stockOutId     String
  qty            Int
  reason         String // expiry, near_expiry, breakage, wrong_item
  note           String?
  status         String // raised, acknowledged, credited, rejected
  claimPaise     BigInt
  creditPaise    BigInt    @default(0)
  writeOffPaise  BigInt    @default(0)
  writeOffReason String?
  credits        Json      @default("[]") // [{ref, amount, at, voucherNo}]
  raisedBy       String
  raisedAt       DateTime  @default(now())
  ackAt          DateTime?
  settledAt      DateTime?

  @@unique([tenantId, no])
  @@index([tenantId, supplierId, status])
}

// Cheques received from customers and issued to suppliers. Postings go through clearing accounts.
model Cheque {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String
  direction    String // received, issued
  partyType    String // customer, supplier
  partyId      String
  no           String
  bank         String
  chequeDate   DateTime  @db.Date
  amountPaise  BigInt
  status       String // pending, deposited, cleared, bounced
  voucherId    String
  note         String?
  createdBy    String
  createdAt    DateTime  @default(now())
  depositedAt  DateTime?
  clearedAt    DateTime?
  bouncedAt    DateTime?
  bounceReason String?
  chargePaise  BigInt    @default(0)

  @@unique([tenantId, direction, partyId, no])
  @@index([tenantId, status, chequeDate])
}

model BankStatement {
  id        String     @id @default(uuid())
  tenantId  String
  fileName  String
  lines     Int
  createdBy String
  createdAt DateTime   @default(now())
  items     BankLine[]
}

// One bank statement row. Amount is signed: + money in (deposit), − money out (withdrawal).
model BankLine {
  id              String        @id @default(uuid())
  tenantId        String
  statementId     String
  statement       BankStatement @relation(fields: [statementId], references: [id])
  date            DateTime      @db.Date
  description     String
  ref             String?
  amountPaise     BigInt
  balancePaise    BigInt?
  row             Int           @default(0) // position in the imported file, to order same-day lines
  fingerprint     String
  ledgerLineId    String?       @unique
  matchedBy       String? // auto, manual; bill / bill-auto when the line paid a credit bill (a receipt was posted for it)
  reconciledAt    DateTime?
  reconciledBy    String?
  /// The credit bill this bank credit paid (bill-level matching, accounting/bank-bills.ts)
  saleId          String?
  /// Bills a person said this credit isn't for: never suggested again
  rejectedSaleIds String[]      @default([])

  @@unique([tenantId, fingerprint])
  @@index([tenantId, date])
}

model Recall {
  id          String   @id @default(uuid())
  tenantId    String
  source      String
  sourceRef   String
  publishedAt DateTime @db.Date
  product     String
  medicineId  String? // null on notices recorded before recalls were tied to a medicine
  batchNos    String[]
  reason      String
  status      String // open, quarantined, returned, resolved
  createdBy   String
  createdAt   DateTime @default(now())
}

// ───────────── Parties ─────────────

model Supplier {
  id               String          @id @default(uuid())
  tenantId         String
  name             String
  gstin            String?
  phone            String?
  creditDays       Int             @default(0)
  leadDays         Decimal         @default(1)
  acceptsReturns   Boolean         @default(true)
  accuracyPct      Int             @default(100) // unused: delivery accuracy is computed from POs and GRNs
  stateCode        String? // 2-digit GST state code; falls back to the GSTIN prefix
  returnWindowDays Int             @default(90) // expiry returns accepted up to this many days before expiry
  ebillMapping     Json? // saved column mapping for this supplier's digital bills
  version          Int             @default(0)
  batches          Batch[]
  orders           PurchaseOrder[]

  @@unique([tenantId, name])
}

model Customer {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  phone            String?
  creditLimitPaise BigInt    @default(0)
  waOptIn          Boolean   @default(false) // transactional WhatsApp: invoices and refill reminders
  optInAt          DateTime?
  optInMethod      String?
  smsOptIn         Boolean   @default(false) // transactional SMS
  marketingWa      Boolean   @default(false) // offers and campaigns, separate from transactional consent
  marketingSms     Boolean   @default(false)
  smsOptInAt       DateTime?
  smsOptInMethod   String?
  // Meta reported the number isn't on WhatsApp: automatic sends skip it until the number changes
  waInvalidAt      DateTime?
  waInvalidReason  String?
  erasedAt         DateTime?
  gstin            String? // B2B buyer: tax invoice, GSTR-1 B2B
  stateCode        String? // place of supply when goods go to another state; falls back to the GSTIN prefix
  address          String? // billing address for B2B tax invoices and e-invoices
  pincode          String?
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  sales            Sale[]

  @@unique([tenantId, phone])
}

/// Every consent given or withdrawn, append-only. Customer flags hold the current state.
model ConsentRecord {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  purpose    String // transactional, marketing
  channel    String // whatsapp, sms
  granted    Boolean
  method     String // counter, form, reply, import
  source     String // where it was recorded: pos, parties, import, whatsapp
  userId     String?
  userName   String?
  at         DateTime @default(now())

  @@index([tenantId, customerId, at])
}

// Balances are derived from vouchers; this table holds supplier bills for due-date tracking.
model SupplierBill {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String
  ref         String
  date        DateTime @db.Date
  dueDate     DateTime @db.Date
  amountPaise BigInt
  paidPaise   BigInt   @default(0)
  grnId       String?
}

// ───────────── Purchasing ─────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  branchId     String
  no           String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PoStatus            @default(draft)
  createdBy    String
  createdAt    DateTime            @default(now())
  source       String? // manual, intel, ai, seasonal
  placedAt     DateTime?
  closedAt     DateTime?
  closedBy     String?
  closedReason String?
  items        PurchaseOrderItem[]

  @@unique([tenantId, no])
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id])
  medicineId String
  qty        Int
  ratePaise  BigInt
  freeQty    Int           @default(0)
  ptsPaise   BigInt?
  mrpPaise   BigInt?
  scheme     String? // e.g. "10+2"
  schemePct  Decimal       @default(0) @db.Decimal(5, 2)
  tradePct   Decimal       @default(0) @db.Decimal(5, 2)
  cashPct    Decimal       @default(0) @db.Decimal(5, 2)
}

model Grn {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String
  no                String
  supplierId        String
  supplierInvoiceNo String
  invoiceDate       DateTime  @db.Date
  totalPaise        BigInt
  poId              String?
  scanDocId         String?
  igst              Boolean   @default(false) // inter-state: input tax booked as IGST
  itc               Boolean   @default(true) // false: GST not claimable (composition), so it is part of cost
  gstBase           String    @default("net") // net, before_cd, gross: see docs/PURCHASING.md
  approvedBy        String
  approvedAt        DateTime  @default(now())
  items             GrnItem[]

  @@unique([tenantId, supplierId, supplierInvoiceNo])
  @@unique([tenantId, no])
}

model GrnItem {
  id         String  @id @default(uuid())
  grnId      String
  grn        Grn     @relation(fields: [grnId], references: [id])
  poItemId   String?
  medicineId String
  batchId    String
  qty        Int
  freeQty    Int     @default(0)
  ratePaise  BigInt // per pack, excluding GST
  gstRate    Int
  ptsPaise   BigInt?
  mrpPaise   BigInt?
  scheme     String?
  schemePct  Decimal @default(0) @db.Decimal(5, 2)
  tradePct   Decimal @default(0) @db.Decimal(5, 2)
  cashPct    Decimal @default(0) @db.Decimal(5, 2)
  discPaise  BigInt  @default(0) // scheme + trade + cash discounts on the paid quantity
  basePaise  BigInt? // value GST was computed on; null on GRNs posted before pricing fields
  gstPaise   BigInt?
  costPaise  BigInt? // landed cost per unit: after discounts, spread over free units (+ GST when not claimable)
}

// Learned links from a supplier's item code (or "N:" + normalised name) to a catalogue medicine.
model SupplierItemMap {
  id         String   @id @default(uuid())
  tenantId   String
  supplierId String
  code       String
  medicineId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, supplierId, code])
}

model ScanDocument {
  id          String   @id @default(uuid())
  tenantId    String
  fileName    String
  storagePath String?
  mime        String?
  sizeBytes   Int?
  sha256      String
  status      String // processing, review, approved, rejected
  extracted   Json
  confidence  Json
  createdBy   String
  createdAt   DateTime @default(now())
}

// ───────────── Sales ─────────────

model Sale {
  id             String     @id @default(uuid())
  tenantId       String
  branchId       String
  invoiceNo      String
  idempotencyKey String
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  prescriber     String?
  rxNo           String?
  prescriberReg  String? // prescriber's registration number (Schedule H1 register)
  patientName    String? // patient on a bill with no customer (Schedule H1 register)
  doctorId       String?
  doctor         Doctor?    @relation(fields: [doctorId], references: [id])
  subtotalPaise  BigInt
  discountPaise  BigInt
  discountPct    Decimal    @default(0)
  taxablePaise   BigInt
  cgstPaise      BigInt
  sgstPaise      BigInt
  igstPaise      BigInt     @default(0) // inter-state supply: all tax is IGST, CGST/SGST are zero
  placeOfSupply  String? // 2-digit state code
  customerGstin  String? // buyer GSTIN at the time of sale
  roundOffPaise  BigInt
  totalPaise     BigInt
  costPaise      BigInt     @default(0)
  payMode        PayMode
  shiftId        String?
  userId         String
  provisional    Boolean    @default(false)
  at             DateTime   @default(now())
  items          SaleItem[]
  payments       Payment[]
  voided         SaleVoid?

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, branchId, invoiceNo])
  @@index([branchId, at])
  @@index([tenantId, doctorId, at])
}

model SaleItem {
  id            String  @id @default(uuid())
  saleId        String
  sale          Sale    @relation(fields: [saleId], references: [id])
  batchId       String
  medicineId    String
  qty           Int
  mrpPaise      BigInt
  discountPaise BigInt
  taxablePaise  BigInt
  gstRate       Int
  costPaise     BigInt
  returnedQty   Int     @default(0)
  loose         Boolean @default(false) // qty, MRP and cost are per loose unit, not per pack
  packSize      Int     @default(1) // Medicine.packSize when sold
}

model Payment {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  mode        PayMode
  amountPaise BigInt
  ref         String?
}

model HeldCart {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  userId    String
  label     String
  cart      Json
  createdAt DateTime @default(now())
}

model SalesReturn {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String
  creditNoteNo String
  saleId       String
  reason       String
  condition    String // sealed, damaged
  refundMode   String
  amountPaise  BigInt
  userId       String
  shiftId      String?
  at           DateTime @default(now())
  lines        Json

  @@unique([tenantId, creditNoteNo])
}

model Shift {
  id            String    @id @default(uuid())
  tenantId      String
  branchId      String
  counter       String
  userId        String?
  openedBy      String
  openingPaise  BigInt
  openedAt      DateTime  @default(now())
  closedBy      String?
  expectedPaise BigInt?
  countedPaise  BigInt?
  closedAt      DateTime?
}

// ───────────── Accounting ─────────────

model Voucher {
  id         String       @id @default(uuid())
  tenantId   String
  branchId   String?
  no         String
  type       VoucherType
  date       DateTime     @default(now())
  narration  String
  refType    String?
  refId      String?
  postedBy   String
  postedAt   DateTime     @default(now())
  reversesId String?
  lines      LedgerLine[]

  @@unique([tenantId, no])
  @@index([tenantId, date])
}

model LedgerLine {
  id          String  @id @default(uuid())
  voucherId   String
  voucher     Voucher @relation(fields: [voucherId], references: [id])
  account     String
  partyType   String? // customer | supplier
  partyId     String?
  debitPaise  BigInt  @default(0)
  creditPaise BigInt  @default(0)

  @@index([account])
  @@index([partyType, partyId])
}

// ───────────── Audit ─────────────

model AuditEvent {
  id       BigInt   @id @default(autoincrement())
  tenantId String
  branchId String?
  userId   String?
  userName String?
  action   String
  entity   String
  entityId String?
  detail   String?
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())
  prevHash String
  hash     String

  @@index([tenantId, at])
}

// ───────────── Integrations ─────────────

model WaMessage {
