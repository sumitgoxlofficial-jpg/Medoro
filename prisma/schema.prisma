  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  kind          String // scheduled, manual, retry
  sizeBytes     BigInt?
  sha256        String?
  schemaVersion String
  localPath     String?
  driveFileId   String?
  status        String // running, verified, failed
  error         String?
  rowCounts     Json?
}

model Device {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  name     String
  kind     String // counter, tablet, host
  offline  Boolean  @default(false)
  quota    Json     @default("{}")
  lastSeen DateTime @default(now())
}

model OfflineOp {
  id          String   @id
  tenantId    String
  deviceId    String
  kind        String
  payload     Json
  baseVersion Int
  status      String // pending, posted, conflict, resolved
  conflict    Json?
  resolution  String?
  createdAt   DateTime
  receivedAt  DateTime @default(now())
}

model Campaign {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  template  String
  audience  Int
  status    String // draft, scheduled, sent
  message   String? // store update text, sent as body variable 2
  createdAt DateTime @default(now())
}

/// One row per AI question, kept for a minute: a sliding-window rate limit shared by every app instance.
model AiAsk {
  id     BigInt   @id @default(autoincrement())
  userId String
  at     DateTime @default(now())

  @@index([userId, at])
}

model AiConfirmation {
  token     String    @id
  tenantId  String
  userId    String
  tool      String
  inputHash String
  input     Json
  preview   Json
  expiresAt DateTime
  usedAt    DateTime?
}

// The pharmacy's copy of its Medoro licence. Fields below `licenceToken` come from the last licence
// document the licence server signed (see src/domain/system/licence.ts).
/// Subscription payments taken online on a hosted server (Razorpay Checkout), one row per order.
model OnlinePayment {
  id            String    @id @default(uuid())
  tenantId      String
  provider      String    @default("razorpay")
  orderId       String    @unique
  paymentId     String?   @unique
  plan          String // product id: starter, pro, multi
  cycle         String // m (month) or y (year)
  amountPaise   Int // total charged, including GST
  gstPaise      Int
  status        String    @default("created") // created, paid, failed, refunded, duplicate (paid twice; refunded automatically)
  periodFrom    DateTime?
  periodTo      DateTime?
  couponCode    String?
  discountPaise Int       @default(0) // coupon discount, off the GST-inclusive list price
  note          String? // why a payment failed, or was refunded
  prevStatus    String? // the plan's status and paid-until before this payment, to undo it on a refund
  prevRenewsAt  DateTime?
  refundId      String?
  refundedAt    DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([tenantId, createdAt])
}

/// Online payments to Medoro (the licence server) from self-hosted and desktop installations, one row per Razorpay order.
model CpOnlinePayment {
  id            String    @id @default(uuid())
  customerId    String
  orderId       String    @unique
  paymentId     String?   @unique
  plan          String // starter, pro, multi
  cycle         String // m, y
  amountPaise   Int // charged, GST included
  gstPaise      Int
  couponCode    String?
  discountPaise Int       @default(0)
  status        String    @default("created") // created, paid, failed, duplicate (refunded)
  note          String?
  refundId      String?
  saleId        String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([customerId, createdAt])
}

/// Subscription coupon codes, made in the staff console and entered by pharmacies before paying online.
model Coupon {
  id         String    @id @default(uuid())
  code       String    @unique // upper case, e.g. LAUNCH20
  percentOff Int // 1 to 100; 0 when payPaise sets a fixed price
  payPaise   Int? // fixed price to pay, GST included (e.g. 100 = ₹1 for testing); overrides percentOff
  plans      String[]  @default([]) // product ids it applies to; empty = every plan
  maxUses    Int? // null = unlimited
  uses       Int       @default(0) // paid orders that used it
  expiresAt  DateTime? // last moment it can be used
  active     Boolean   @default(true)
  note       String?
  createdBy  String
  createdAt  DateTime  @default(now())
}

model SubscriptionMeta {
  tenantId      String    @id
  plan          String
  addons        String[]
  status        String // trial, active, grace, cancelled (as issued)
  renewsAt      DateTime? // trial end or paid-until
  aiUntil       DateTime? // AI Pharmacy Manager add-on paid until (hosted servers that take payments themselves)
  graceUntil    DateTime?
  licenceToken  String? // sealed instance token used to sign check-ins
  licenceId     String?
  graceDays     Int       @default(7)
  signedDoc     String? // the last verified licence document, as received
  issuedAt      DateTime?
  checkedAt     DateTime? // last check-in attempt
  checkError    String?
  inbox         Json      @default("{}") // invoices, billing events, tickets and support requests from Medoro
  supportSeenAt DateTime?
}

// Requests to Medoro (tickets, add-on and plan changes, payment claims, support-access answers),
// sent immediately when possible and otherwise with the next licence check-in.
model LicenceOutbox {
  id        String    @id @default(uuid())
  tenantId  String
  kind      String
  payload   Json
  createdBy String
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  result    Json?

  @@index([tenantId, sentAt])
}

// One pending SMS code per phone: hashed, 5-minute expiry, 5 attempts.
model OtpCode {
  phone     String   @id
  codeHash  String
  purpose   String // signin, invite
  attempts  Int      @default(0)
  expiresAt DateTime
}

// ───────────────────────── Medoro control plane (staff console) ─────────────────────────
// Medoro's own records: staff, sales pipeline, commission, customer accounts and support.
// Nothing here links to pharmacy tables; staff code never reads them.

enum StaffRole {
  super_admin
  sales
  care
  partner // reference partner: an outside MR or consultant who refers pharmacies for commission
  employee // a Medoro employee who only uses the HRMS (no staff console)
}

enum StaffStatus {
  invited
  pending
  active
  deactivated
}

model StaffUser {
  id              String                  @id @default(uuid())
  empNo           String                  @unique
  name            String
  email           String
  kind            String                  @default("team") // team (Medoro employees) or partner: one email can have one of each
  phone           String
  role            StaffRole
  team            String                  @default("")
  status          StaffStatus
  passwordHash    String?
  totpSecret      String? // sealed
  totpEnabled     Boolean                 @default(false)
  referralCode    String?                 @unique
  googleSub       String?                 @unique // reference partners can sign in with Google
  bonusPct        Decimal                 @default(0) @db.Decimal(5, 2)
  inviteTokenHash String?                 @unique
  inviteExpiresAt DateTime?
  tokenVersion    Int                     @default(0)
  approvedBy      String?
  createdAt       DateTime                @default(now())
  sessions        StaffSession[]
  bank            StaffBank?
  growthMember    GrowthMember?
  territories     EmployeeTerritory[]
  callingTargets  EmployeeCallingTarget[]
  leadAssignments LeadAssignment[]
  callSessions    CallSession[]
  followUps       FollowUpTask[]
  hr              HrProfile?

  @@unique([email, kind])
}

model StaffSession {
  id           String    @id // sha256 of the cookie token
  staffId      String
  staff        StaffUser @relation(fields: [staffId], references: [id])
  tokenVersion Int
  mfaPassed    Boolean   @default(false)
  kind         String    @default("console") // console (password + authenticator, or Google) or hrms (HRMS password sign-in)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
}

model StaffBank {
  staffId          String    @id
  staff            StaffUser @relation(fields: [staffId], references: [id])
  holder           String
  accountSealed    String
  last4            String
  ifsc             String
  bank             String
  type             String
  panSealed        String
  panMasked        String
  status           String // pending, verified
  addedAt          DateTime  @default(now())
  verifiedAt       DateTime?
  verifiedBy       String?
  rzpFundAccountId String? // RazorpayX fund account for this bank account; cleared when it changes
}

/**
 * A payment of commission to a sales person or reference partner, by RazorpayX payout or a recorded bank transfer.
 */
model StaffPayout {
  id          String   @id @default(uuid())
  ref         String   @unique
  staffId     String
  grossPaise  Int
  tdsPaise    Int
  netPaise    Int
  saleIds     String[]
  method      String // razorpay, manual
  rzpPayoutId String?  @unique
  status      String // processing, paid, failed
  utr         String?
  failure     String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([staffId, createdAt])
}

model StaffAudit {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  staffId   String?
  staffName String
  action    String
  detail    String?
  ip        String?
}

model CpSetting {
  key   String @id
  value Json
}

model CpCustomer {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  owner        String
  phone        String           @unique // 10 digits
  email        String           @default("")
  city         String           @default("")
  address      String           @default("")
  gstin        String           @default("")
  drugLicence  String           @default("")
  product      String // starter, pro, multi
  addons       String[]
  cycle        String // m, y
  status       String // trial, active, grace, cancelled
  since        DateTime         @db.Date
  renewsOn     DateTime?        @db.Date
  branches     Int              @default(1)
  devices      Int              @default(1)
  deployment   String           @default("")
  lastCheckIn  DateTime?
  appVersion   String?
  salesStaffId String?
  createdAt    DateTime         @default(now())
  licenceId    String?          @unique
  licenceToken String? // sealed; the instance signs check-ins with it
  graceDays    Int              @default(7)
  notes        CpNote[]
  tickets      Ticket[]
  billing      CpBillingEvent[]
}

// Billing history per customer: invoices, payment claims from the app, add-on/cancel requests, trial extensions.
model CpBillingEvent {
  id          String     @id @default(uuid())
  customerId  String
  customer    CpCustomer @relation(fields: [customerId], references: [id])
  kind        String // invoice, payment_claim, addon_add, addon_remove, cancel, trial_extended
  status      String // open, done, rejected
  number      String?    @unique // invoice number
  amountPaise Int        @default(0) // before GST
  gstPaise    Int        @default(0)
  reference   String?
  detail      String     @default("")
  saleId      String?
  requestId   String?    @unique // the pharmacy's outbox id, so a resend is not a duplicate
  byName      String
  createdAt   DateTime   @default(now())
  decidedAt   DateTime?
  decidedBy   String?
}

model CpNote {
  id         String     @id @default(uuid())
  customerId String
  customer   CpCustomer @relation(fields: [customerId], references: [id])
  text       String
  byName     String
  staffId    String
  at         DateTime   @default(now())
}

model Lead {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  owner          String
  phone          String    @unique // 10 digits
  city           String
  source         String
  product        String
  stage          String // new, contacted, demo, trial, won, lost
  nextOn         DateTime? @db.Date
  staffId        String
  lostReason     String?
  discountPct    Int?
  discountStatus String? // pending, approved, rejected
  email          String    @default("")
  createdAt      DateTime  @default(now())
  logs           LeadLog[]
}

model LeadLog {
  id      String   @id @default(uuid())
  leadId  String
  lead    Lead     @relation(fields: [leadId], references: [id])
  text    String
  staffId String
  at      DateTime @default(now())
}

model CpSale {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  pharmacy        String
  phone           String
  city            String    @default("")
  customerId      String?
  product         String
  cycle           String // m, y
  type            String // new, renewal
  staffId         String
  status          String // pending, verified, paid, rejected
  amountPaise     Int // before GST
  ratePct         Decimal   @db.Decimal(5, 2)
  commissionPaise Int
  leadId          String?
  verifiedBy      String?
  verifiedAt      DateTime?
  paidAt          DateTime?
  payoutRef       String?
  payRef          String? // UPI/bank reference the pharmacy entered in its app
  createdAt       DateTime  @default(now())
}

model Ticket {
  id               String          @id @default(uuid())
  code             String          @unique
  customerId       String
  customer         CpCustomer      @relation(fields: [customerId], references: [id])
  subject          String
  category         String          @default("General")
  channel          String          @default("Phone")
  priority         String // high, medium, low
  status           String // open, waiting, resolved
  assigneeId       String?
  escalatedTo      String?
  createdAt        DateTime        @default(now())
  firstResponseDue DateTime
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  messages         TicketMessage[]
}

model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  text         String
  byName       String
  staffId      String?
  internal     Boolean  @default(false)
  fromCustomer Boolean  @default(false)
  at           DateTime @default(now())
}

model RemoteAccessRequest {
  id          String    @id @default(uuid())
  customerId  String
  staffId     String
  ticketId    String?
  status      String // requested, approved, denied, expired
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  expiresAt   DateTime?
  link        String? // sealed single-use support link the owner approved with
}

// A restore from backup: loaded into a test copy (a separate schema) first, applied to live only after the owner confirms.
model RestoreRun {
  id             String    @id @default(uuid())
  tenantId       String
  manifestId     String
  schemaName     String // e.g. restore_ab12cd34; dropped after apply or discard
  status         String // prepared, applied, discarded, failed
  summary        Json // per-table counts, backup vs live, and key figures
  createdBy      String
  createdAt      DateTime  @default(now())
  appliedAt      DateTime?
  appliedBy      String?
  safetyBackupId String?
  error          String?
}

// Time-limited, read-only access the owner grants to Medoro support. The link works once.
model SupportGrant {
  id          String    @id @default(uuid())
  tenantId    String
  tokenHash   String    @unique
  reason      String
  minutes     Int
  createdById String
  createdBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedIp      String?
  revokedAt   DateTime?
  revokedBy   String?
}

/// IRP and e-way bill results, append-only. The latest row of a kind for a document wins; a cancellation is a new row.
model EInvoice {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  docType   String // sale, transfer
  docId     String
  docNo     String
  kind      String // irn, irn_cancel, ewb
  irn       String?
  ackNo     String?
  ackDt     String?
  signedQr  String?
  signedInv String?
  ewbNo     String?
  ewbDate   String?
  ewbValid  String?
  request   Json
  response  Json
  userId    String
  at        DateTime @default(now())

  @@index([tenantId, docType, docId])
}

/// Files kept in the database (invoice scans, encrypted backups) when the host has no persistent disk
/// and no object storage is configured. Key: "<tenantId>/<kind>/<file>".
model FileObject {
  key         String   @id
  tenantId    String
  contentType String
  bytes       Bytes? // null when the file is kept in the pharmacy's Google Drive
  driveFileId String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

/// A same-day void of a whole sale. Append-only; the sale itself is never changed.
model SaleVoid {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  saleId          String   @unique
  sale            Sale     @relation(fields: [saleId], references: [id])
  reason          String
  userId          String
  shiftId         String?
  /// Refunds per payment mode: [{ mode, amountPaise }]
  refunds         Json
  cashRefundPaise BigInt   @default(0)
  at              DateTime @default(now())

  @@index([tenantId, branchId, at])
}

/// A manager's on-the-spot approval of a discount above the cashier's cap: single use, bound to the cart.
model DiscountApproval {
  id          String    @id @default(uuid())
  tenantId    String
  branchId    String
  tokenHash   String    @unique
  requestedBy String
  approvedBy  String
  discountPct Decimal
  cartHash    String
  totalPaise  BigInt
  expiresAt   DateTime
  usedAt      DateTime?
  saleId      String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
}

// ───────────── Orders & home delivery ─────────────

enum OrderStatus {
  new
  confirmed
  packed
  out_for_delivery
  delivered
  cancelled
  returned
}

/// A customer order (phone, WhatsApp or counter) delivered to an address. Packing bills it as a normal sale.
model DeliveryOrder {
  id             String              @id @default(uuid())
  tenantId       String
  branchId       String
  no             String
  source         String // phone, whatsapp, walk_in
  customerId     String?
  name           String
  phone          String
  address        String
  slotDate       DateTime?           @db.Date
  slot           String?
  notes          String?
  payMode        String // cod, prepaid, credit
  payRef         String?
  discountPct    Decimal             @default(0)
  prescriber     String?
  prescriberReg  String? // Schedule H1, X and NDPS items: prescriber's registration number
  rxPath         String?
  rxMime         String?
  waConsent      Boolean             @default(false)
  status         OrderStatus         @default(new)
  estimatePaise  BigInt              @default(0)
  saleId         String?             @unique
  invoiceNo      String?
  totalPaise     BigInt?
  riderId        String?
  otpHash        String?
  otpAttempts    Int                 @default(0)
  proof          String? // otp, signature
  receivedBy     String?
  collectedPaise BigInt              @default(0)
  collectedMode  String? // cash, upi
  settlementId   String?
  reason         String? // cancel/return reason, or the last failed delivery attempt
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deliveredAt    DateTime?
  items          DeliveryOrderItem[]

  @@unique([tenantId, no])
  @@index([tenantId, branchId, status])
  @@index([tenantId, riderId, status])
}

model DeliveryOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  order      DeliveryOrder @relation(fields: [orderId], references: [id])
  medicineId String
  qty        Int
}

/// Order history: every status change, failed attempt and customer notification. Append-only.
model DeliveryEvent {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  orderId  String
  kind     String // a status, attempt_failed, notified, rx_uploaded, rider_assigned
  note     String?
  userId   String?
  userName String?
  at       DateTime @default(now())

  @@index([orderId, at])
}

/// Cash on delivery handed over by a delivery person at the counter. Append-only.
model RiderSettlement {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  no            String
  riderId       String
  orderIds      String[]
  expectedPaise BigInt
  countedPaise  BigInt
  shiftId       String?
  userId        String
  note          String?
  at            DateTime @default(now())

  @@unique([tenantId, no])
  @@index([tenantId, branchId, at])
}

/// Loyalty points, one row per change; a balance is the sum of points. Append-only.
model LoyaltyLedger {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  kind       String // earn, redeem, reverse, restore, expire
  points     Int
  valuePaise BigInt    @default(0) // redeem/restore: rupee value at the sale's point rate
  saleId     String?
  returnId   String?
  expiresAt  DateTime?
  note       String?
  userId     String?
  at         DateTime  @default(now())

  @@index([tenantId, customerId])
  @@index([saleId])
}

/// DriveDB (Drive mode): a device allowed to sync this pharmacy's encrypted data through Medoro's relay.
/// Only its public key and status live here; the data and keys are in the owner's Google Drive.
model DriveDevice {
  id          String    @id @default(uuid())
  tenantId    String
  deviceId    String
  userId      String
  name        String
  role        String // owner | staff
  status      String    @default("pending") // pending | approved | removed
  publicKey   Json
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  lastSeen    DateTime?
  lastSyncAt  DateTime? // last sync with Google Drive that worked
  lastError   String? // the device's last sync error (text only), cleared by the next good sync
  lastErrorAt DateTime?

  @@unique([tenantId, deviceId])
  @@index([tenantId, status])
}

/// Drive mode: a customer's online payment waiting for a counter, sealed for one device (only it can open it).
model PaymentInbox {
  id        String   @id @default(uuid())
  tenantId  String
  deviceId  String
  paymentId String
  sealed    String // JSON {k, iv, ct}: AES-GCM payload, its key wrapped with the device's RSA-OAEP public key
  createdAt DateTime @default(now())

  @@unique([tenantId, deviceId, paymentId])
  @@index([tenantId, paymentId])
}

/// WhatsApp opt-outs of Drive mode pharmacies, whose customers aren't on Medoro's server: a STOP reply (Meta webhook)
/// is kept as a keyed hash of the number, so a campaign sent from a counter skips it. No number is stored.
model WaOptOut {
  id        String   @id @default(uuid())
  tenantId  String
  phoneHash String // HMAC-SHA256 of the 10-digit number, keyed from HOST_KEY and the pharmacy (see comms/opt-outs.ts)
  createdAt DateTime @default(now())

  @@unique([tenantId, phoneHash])
}

/// Delivery status of WhatsApp messages a Drive counter sent through the Meta Cloud API, so the counter can show
/// delivered / read. Only Meta's message id and its status: no phone number, no text, no bill. Kept 7 days.
/// (Messages from a linked phone need no row: the WhatsApp connector is asked directly.)
model CounterMsgStatus {
  id        String   @id @default(uuid())
  tenantId  String
  wamid     String
  status    String // sent | delivered | read | failed
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, wamid])
  @@index([createdAt])
}

// ───────────────────────── Growth Intelligence (staff console) ─────────────────────────
// Medoro's own pharmacy prospecting: leads, assignments, calls, follow-ups, campaigns, consent.
// Part of the control plane: never linked to pharmacy (tenant) tables, never holds patient data.
