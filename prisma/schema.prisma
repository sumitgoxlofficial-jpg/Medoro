// Medoro — PostgreSQL 16. Based on design/schema.reference.prisma.
// Money is BigInt paise. Posted rows (movements, ledger, audit) are append-only:
// DB triggers in the init migration block UPDATE/DELETE on them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BatchStatus {
  ok
  quarantine
  damaged
  recalled
}

enum PoStatus {
  draft
  ordered
  partially_received
  received
  cancelled
  closed // short-closed: the remaining quantity is no longer expected
}

enum PayMode {
  cash
  upi
  card
  credit
  split
  cod // cash on delivery: with the delivery person until handed over (docs/ORDERS_AND_DELIVERY.md)
  loyalty // points redeemed at the counter (see LoyaltyLedger)
}

enum MsgStatus {
  queued
  sent
  delivered
  read
  failed
}

enum VoucherType {
  receipt
  payment
  journal
  credit_note
  debit_note
  reversal
  sales
  purchase
}

// ───────────── Tenancy & identity ─────────────

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique // pharmacy code staff type at employee login, e.g. SANJ-PUNE
  name      String
  legalName String?
  gstin     String?
  phone     String?
  createdAt DateTime @default(now())
  branches  Branch[]
  users     User[]
  roles     Role[]
  settings  Json     @default("{}")
}

model Branch {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  code        String // short code used in invoice numbers, e.g. KOT
  address     String?
  gstin       String?
  drugLicence String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  permissions String[]
  locked      Boolean  @default(false)
  users       User[]

  @@unique([tenantId, name])
}

model User {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  name            String
  email           String?
  phone           String?
  passwordHash    String?
  employeeNo      String? // E-101; used with pharmacy code + PIN at counters
  pinHash         String?
  mfaSecret       String?
  mfaRequired     Boolean        @default(false)
  mfaEnabled      Boolean        @default(false)
  tokenVersion    Int            @default(0)
  active          Boolean        @default(true)
  roleId          String
  role            Role           @relation(fields: [roleId], references: [id])
  branchIds       String[] // empty = all branches
  lastLoginAt     DateTime?
  failedLogins    Int            @default(0)
  lockedUntil     DateTime?
  isSupport       Boolean        @default(false) // the read-only "Medoro support" login an owner can grant
  googleSub       String?        @unique // linked "Sign in with Google" account (OIDC subject)
  googleEmail     String?
  passwordResetAt DateTime? // last forgot-password reset; holds back an OTP-only MFA reset for 24 h
  permGrants      String[]       @default([]) // permissions granted to this user on top of the role
  permRevokes     String[]       @default([]) // role permissions withheld from this user
  sessions        Session[]
  recoveryCodes   RecoveryCode[]
  authCodes       AuthCode[]
  createdAt       DateTime       @default(now())

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([tenantId, employeeNo])
}

model Invite {
  id        String    @id @default(uuid())
  tenantId  String
  code      String    @unique // e.g. 7Q4K-29, valid 48 h
  name      String?
  contact   String // email or mobile
  roleName  String
  branchId  String?
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
}

model Counter {
  id       String  @id @default(uuid())
  tenantId String
  branchId String
  name     String
  active   Boolean @default(true)

  @@unique([branchId, name])
}

// Sign-in throttling per account+IP key.
model LoginAttempt {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// One-time MFA recovery codes, stored as hashes. Shown once at enrolment or regeneration.
model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Single-use codes sent by email or SMS for password reset and lost-authenticator recovery.
model AuthCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // reset, mfa-reset
  channel   String // email, sms
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// Fixed-window request counters for expensive or abusable actions (src/server/ratelimit.ts).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

model Session {
  id           String    @id // sha256 of the cookie token
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenVersion Int
  device       String?
  counterId    String?
  mfaPassed    Boolean   @default(false)
  firstFactor  String? // password, google, otp or pin: what this sign-in proved before MFA
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
}

// Generic per-tenant counters: invoice numbers, voucher numbers, PO/GRN numbers.
model Sequence {
  tenantId String
  key      String // e.g. "INV:<branchId>:2627", "RV", "PO:2627"
  next     Int    @default(1)

  @@id([tenantId, key])
}

// ───────────── Catalogue & inventory ─────────────

model Medicine {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  generic      String
  strength     String
  form         String
  manufacturer String
  pack         String
  unitsPerPack Int            @default(1)
  barcode      String?
  hsn          String
  gstRate      Int
  mrpPaise     BigInt
  schedule     String? // H, H1, X or null
  reorderLevel Int            @default(0)
  rack         String?
  composition  String? // salts with strengths, e.g. "Paracetamol 500mg + Caffeine 25mg"
  saltKey      String? // order-independent normalised composition; equal keys are substitutes
  packSize     Int            @default(1) // stock units in one MRP pack; batch quantities are in stock units
  packUnit     String         @default("pack") // what one MRP pack is called: strip, bottle
  looseUnit    String         @default("unit") // the stock unit when sold loose: tab, cap
  allowLoose   Boolean        @default(false)
  caseSize     Int            @default(1) // packs in one purchase case
  caseUnit     String         @default("box")
  active       Boolean        @default(true)
  version      Int            @default(0)
  createdAt    DateTime       @default(now())
  batches      Batch[]
  racks        MedicineRack[]

  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@index([tenantId, generic])
  @@index([tenantId, saltKey])
}

// Branch-specific shelf location; falls back to Medicine.rack.
model MedicineRack {
  tenantId   String
  branchId   String
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  rack       String
  updatedAt  DateTime @updatedAt

  @@id([branchId, medicineId])
  @@index([tenantId, branchId, rack])
}

model Doctor {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  qualification String?
  regNo         String? // State Medical Council / NMC registration number
  clinic        String?
  phone         String?
  address       String?
  active        Boolean  @default(true)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  sales         Sale[]

  @@unique([tenantId, regNo])
  @@index([tenantId, name])
}

model Batch {
  id             String          @id @default(uuid())
  tenantId       String
  branchId       String
  medicineId     String
  medicine       Medicine        @relation(fields: [medicineId], references: [id])
  batchNo        String
  mfgDate        DateTime?       @db.Date
  expiryDate     DateTime        @db.Date
  qtyAvailable   Int
  qtyQuarantined Int             @default(0)
  costPaise      BigInt
  mrpPaise       BigInt
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  grnId          String?
  status         BatchStatus     @default(ok)
  statusNote     String?
  version        Int             @default(0)
  createdAt      DateTime        @default(now())
  movements      StockMovement[]

  @@unique([tenantId, branchId, medicineId, batchNo])
  @@index([branchId, medicineId, expiryDate])
}

model StockMovement {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  batchId  String
  batch    Batch    @relation(fields: [batchId], references: [id])
  qty      Int
  type     String // sale, return, grn, adjust, count, transfer_out, transfer_in, quarantine, release, opening
  refType  String
  refId    String
  userId   String
  at       DateTime @default(now())
  note     String?

  @@index([batchId, at])
  @@index([tenantId, refType, refId])
  @@index([tenantId, branchId, at])
}

model StockCount {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  no       String
  userId   String
  at       DateTime @default(now())
  lines    Json // [{batchId, system, counted, valuePaise}]
  note     String?
}

model Transfer {
  id         String    @id @default(uuid())
  tenantId   String
  no         String
  fromBranch String
  toBranch   String
  batchId    String
  qty        Int
  status     String // pending, in_transit, received, rejected
  createdBy  String
  createdAt  DateTime  @default(now())
  approvedBy String?
  approvedAt DateTime?
  receivedBy String?
  receivedAt DateTime?
  note       String?

  @@unique([tenantId, no])
}

// Goods returned to a supplier (debit note) or written off.
model StockOut {
  id         String   @id @default(uuid())
  tenantId   String
  branchId   String
  no         String
  kind       String // supplier_return, write_off
  supplierId String?
  batchId    String
  qty        Int
  valuePaise BigInt
  reason     String
  userId     String
  at         DateTime @default(now())

  @@unique([tenantId, no])
}

// Expiry / breakage claim on a supplier: stock leaves at once; the payable drops only when their credit note arrives.
model SupplierClaim {
  id             String    @id @default(uuid())
  tenantId       String
  branchId       String
  no             String
  supplierId     String
  batchId        String
  stockOutId     String
  qty            Int
  reason         String // expiry, near_expiry, breakage, wrong_item
  note           String?
  status         String // raised, acknowledged, credited, rejected
  claimPaise     BigInt
  creditPaise    BigInt    @default(0)
  writeOffPaise  BigInt    @default(0)
  writeOffReason String?
  credits        Json      @default("[]") // [{ref, amount, at, voucherNo}]
  raisedBy       String
  raisedAt       DateTime  @default(now())
  ackAt          DateTime?
  settledAt      DateTime?

  @@unique([tenantId, no])
  @@index([tenantId, supplierId, status])
}

// Cheques received from customers and issued to suppliers. Postings go through clearing accounts.
model Cheque {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String
  direction    String // received, issued
  partyType    String // customer, supplier
  partyId      String
  no           String
  bank         String
  chequeDate   DateTime  @db.Date
  amountPaise  BigInt
  status       String // pending, deposited, cleared, bounced
  voucherId    String
  note         String?
  createdBy    String
  createdAt    DateTime  @default(now())
  depositedAt  DateTime?
  clearedAt    DateTime?
  bouncedAt    DateTime?
  bounceReason String?
  chargePaise  BigInt    @default(0)

  @@unique([tenantId, direction, partyId, no])
  @@index([tenantId, status, chequeDate])
}

model BankStatement {
  id        String     @id @default(uuid())
  tenantId  String
  fileName  String
  lines     Int
  createdBy String
  createdAt DateTime   @default(now())
  items     BankLine[]
}

// One bank statement row. Amount is signed: + money in (deposit), − money out (withdrawal).
model BankLine {
  id           String        @id @default(uuid())
  tenantId     String
  statementId  String
  statement    BankStatement @relation(fields: [statementId], references: [id])
  date         DateTime      @db.Date
  description  String
  ref          String?
  amountPaise  BigInt
  balancePaise BigInt?
  row          Int           @default(0) // position in the imported file, to order same-day lines
  fingerprint  String
  ledgerLineId String?       @unique
  matchedBy    String? // auto, manual
  reconciledAt DateTime?
  reconciledBy String?

  @@unique([tenantId, fingerprint])
  @@index([tenantId, date])
}

model Recall {
  id          String   @id @default(uuid())
  tenantId    String
  source      String
  sourceRef   String
  publishedAt DateTime @db.Date
  product     String
  medicineId  String? // null on notices recorded before recalls were tied to a medicine
  batchNos    String[]
  reason      String
  status      String // open, quarantined, returned, resolved
  createdBy   String
  createdAt   DateTime @default(now())
}

// ───────────── Parties ─────────────

model Supplier {
  id               String          @id @default(uuid())
  tenantId         String
  name             String
  gstin            String?
  phone            String?
  creditDays       Int             @default(0)
  leadDays         Decimal         @default(1)
  acceptsReturns   Boolean         @default(true)
  accuracyPct      Int             @default(100) // unused: delivery accuracy is computed from POs and GRNs
  stateCode        String? // 2-digit GST state code; falls back to the GSTIN prefix
  returnWindowDays Int             @default(90) // expiry returns accepted up to this many days before expiry
  ebillMapping     Json? // saved column mapping for this supplier's digital bills
  version          Int             @default(0)
  batches          Batch[]
  orders           PurchaseOrder[]

  @@unique([tenantId, name])
}

model Customer {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  phone            String?
  creditLimitPaise BigInt    @default(0)
  waOptIn          Boolean   @default(false) // transactional WhatsApp: invoices and refill reminders
  optInAt          DateTime?
  optInMethod      String?
  smsOptIn         Boolean   @default(false) // transactional SMS
  marketingWa      Boolean   @default(false) // offers and campaigns, separate from transactional consent
  marketingSms     Boolean   @default(false)
  smsOptInAt       DateTime?
  smsOptInMethod   String?
  // Meta reported the number isn't on WhatsApp: automatic sends skip it until the number changes
  waInvalidAt      DateTime?
  waInvalidReason  String?
  erasedAt         DateTime?
  gstin            String? // B2B buyer: tax invoice, GSTR-1 B2B
  stateCode        String? // place of supply when goods go to another state; falls back to the GSTIN prefix
  address          String? // billing address for B2B tax invoices and e-invoices
  pincode          String?
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  sales            Sale[]

  @@unique([tenantId, phone])
}

/// Every consent given or withdrawn, append-only. Customer flags hold the current state.
model ConsentRecord {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  purpose    String // transactional, marketing
  channel    String // whatsapp, sms
  granted    Boolean
  method     String // counter, form, reply, import
  source     String // where it was recorded: pos, parties, import, whatsapp
  userId     String?
  userName   String?
  at         DateTime @default(now())

  @@index([tenantId, customerId, at])
}

// Balances are derived from vouchers; this table holds supplier bills for due-date tracking.
model SupplierBill {
  id          String   @id @default(uuid())
  tenantId    String
  supplierId  String
  ref         String
  date        DateTime @db.Date
  dueDate     DateTime @db.Date
  amountPaise BigInt
  paidPaise   BigInt   @default(0)
  grnId       String?
}

// ───────────── Purchasing ─────────────

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  branchId     String
  no           String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PoStatus            @default(draft)
  createdBy    String
  createdAt    DateTime            @default(now())
  source       String? // manual, intel, ai, seasonal
  placedAt     DateTime?
  closedAt     DateTime?
  closedBy     String?
  closedReason String?
  items        PurchaseOrderItem[]

  @@unique([tenantId, no])
}

model PurchaseOrderItem {
  id         String        @id @default(uuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id])
  medicineId String
  qty        Int
  ratePaise  BigInt
  freeQty    Int           @default(0)
  ptsPaise   BigInt?
  mrpPaise   BigInt?
  scheme     String? // e.g. "10+2"
  schemePct  Decimal       @default(0) @db.Decimal(5, 2)
  tradePct   Decimal       @default(0) @db.Decimal(5, 2)
  cashPct    Decimal       @default(0) @db.Decimal(5, 2)
}

model Grn {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String
  no                String
  supplierId        String
  supplierInvoiceNo String
  invoiceDate       DateTime  @db.Date
  totalPaise        BigInt
  poId              String?
  scanDocId         String?
  igst              Boolean   @default(false) // inter-state: input tax booked as IGST
  itc               Boolean   @default(true) // false: GST not claimable (composition), so it is part of cost
  gstBase           String    @default("net") // net, before_cd, gross: see docs/PURCHASING.md
  approvedBy        String
  approvedAt        DateTime  @default(now())
  items             GrnItem[]

  @@unique([tenantId, supplierId, supplierInvoiceNo])
  @@unique([tenantId, no])
}

model GrnItem {
  id         String  @id @default(uuid())
  grnId      String
  grn        Grn     @relation(fields: [grnId], references: [id])
  poItemId   String?
  medicineId String
  batchId    String
  qty        Int
  freeQty    Int     @default(0)
  ratePaise  BigInt // per pack, excluding GST
  gstRate    Int
  ptsPaise   BigInt?
  mrpPaise   BigInt?
  scheme     String?
  schemePct  Decimal @default(0) @db.Decimal(5, 2)
  tradePct   Decimal @default(0) @db.Decimal(5, 2)
  cashPct    Decimal @default(0) @db.Decimal(5, 2)
  discPaise  BigInt  @default(0) // scheme + trade + cash discounts on the paid quantity
  basePaise  BigInt? // value GST was computed on; null on GRNs posted before pricing fields
  gstPaise   BigInt?
  costPaise  BigInt? // landed cost per unit: after discounts, spread over free units (+ GST when not claimable)
}

// Learned links from a supplier's item code (or "N:" + normalised name) to a catalogue medicine.
model SupplierItemMap {
  id         String   @id @default(uuid())
  tenantId   String
  supplierId String
  code       String
  medicineId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, supplierId, code])
}

model ScanDocument {
  id          String   @id @default(uuid())
  tenantId    String
  fileName    String
  storagePath String?
  mime        String?
  sizeBytes   Int?
  sha256      String
  status      String // processing, review, approved, rejected
  extracted   Json
  confidence  Json
  createdBy   String
  createdAt   DateTime @default(now())
}

// ───────────── Sales ─────────────

model Sale {
  id             String     @id @default(uuid())
  tenantId       String
  branchId       String
  invoiceNo      String
  idempotencyKey String
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  prescriber     String?
  rxNo           String?
  prescriberReg  String? // prescriber's registration number (Schedule H1 register)
  patientName    String? // patient on a bill with no customer (Schedule H1 register)
  doctorId       String?
  doctor         Doctor?    @relation(fields: [doctorId], references: [id])
  subtotalPaise  BigInt
  discountPaise  BigInt
  discountPct    Decimal    @default(0)
  taxablePaise   BigInt
  cgstPaise      BigInt
  sgstPaise      BigInt
  igstPaise      BigInt     @default(0) // inter-state supply: all tax is IGST, CGST/SGST are zero
  placeOfSupply  String? // 2-digit state code
  customerGstin  String? // buyer GSTIN at the time of sale
  roundOffPaise  BigInt
  totalPaise     BigInt
  costPaise      BigInt     @default(0)
  payMode        PayMode
  shiftId        String?
  userId         String
  provisional    Boolean    @default(false)
  at             DateTime   @default(now())
  items          SaleItem[]
  payments       Payment[]
  voided         SaleVoid?

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, branchId, invoiceNo])
  @@index([branchId, at])
  @@index([tenantId, doctorId, at])
}

model SaleItem {
  id            String  @id @default(uuid())
  saleId        String
  sale          Sale    @relation(fields: [saleId], references: [id])
  batchId       String
  medicineId    String
  qty           Int
  mrpPaise      BigInt
  discountPaise BigInt
  taxablePaise  BigInt
  gstRate       Int
  costPaise     BigInt
  returnedQty   Int     @default(0)
  loose         Boolean @default(false) // qty, MRP and cost are per loose unit, not per pack
  packSize      Int     @default(1) // Medicine.packSize when sold
}

model Payment {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  mode        PayMode
  amountPaise BigInt
  ref         String?
}

model HeldCart {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  userId    String
  label     String
  cart      Json
  createdAt DateTime @default(now())
}

model SalesReturn {
  id           String   @id @default(uuid())
  tenantId     String
  branchId     String
  creditNoteNo String
  saleId       String
  reason       String
  condition    String // sealed, damaged
  refundMode   String
  amountPaise  BigInt
  userId       String
  shiftId      String?
  at           DateTime @default(now())
  lines        Json

  @@unique([tenantId, creditNoteNo])
}

model Shift {
  id            String    @id @default(uuid())
  tenantId      String
  branchId      String
  counter       String
  userId        String?
  openedBy      String
  openingPaise  BigInt
  openedAt      DateTime  @default(now())
  closedBy      String?
  expectedPaise BigInt?
  countedPaise  BigInt?
  closedAt      DateTime?
}

// ───────────── Accounting ─────────────

model Voucher {
  id         String       @id @default(uuid())
  tenantId   String
  branchId   String?
  no         String
  type       VoucherType
  date       DateTime     @default(now())
  narration  String
  refType    String?
  refId      String?
  postedBy   String
  postedAt   DateTime     @default(now())
  reversesId String?
  lines      LedgerLine[]

  @@unique([tenantId, no])
  @@index([tenantId, date])
}

model LedgerLine {
  id          String  @id @default(uuid())
  voucherId   String
  voucher     Voucher @relation(fields: [voucherId], references: [id])
  account     String
  partyType   String? // customer | supplier
  partyId     String?
  debitPaise  BigInt  @default(0)
  creditPaise BigInt  @default(0)

  @@index([account])
  @@index([partyType, partyId])
}

// ───────────── Audit ─────────────

model AuditEvent {
  id       BigInt   @id @default(autoincrement())
  tenantId String
  branchId String?
  userId   String?
  userName String?
  action   String
  entity   String
  entityId String?
  detail   String?
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())
  prevHash String
  hash     String

  @@index([tenantId, at])
}

// ───────────── Integrations ─────────────

model WaMessage {
  id             String    @id @default(uuid())
  tenantId       String
  invoiceId      String
  invoiceNo      String
  recipient      String
  idempotencyKey String    @unique
  wamid          String?
  status         MsgStatus
  attempts       Int       @default(0)
  errorCode      String?
  channel        String    @default("whatsapp") // whatsapp | sms
  customerId     String?
  payload        Json? // what to send, so the delivery worker can retry it
  errorKind      String? // retry | permanent | invalid | auth
  nextAttemptAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
}

model Integration {
  id              String    @id @default(uuid())
  tenantId        String
  kind            String // whatsapp, gdrive
  config          Json
  encryptedSecret Bytes?
  connectedAt     DateTime?
  rotatedAt       DateTime?

  @@unique([tenantId, kind])
}

model BackupManifest {
  id            String    @id @default(uuid())
  tenantId      String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  kind          String // scheduled, manual, retry
  sizeBytes     BigInt?
  sha256        String?
  schemaVersion String
  localPath     String?
  driveFileId   String?
  status        String // running, verified, failed
  error         String?
  rowCounts     Json?
}

model Device {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  name     String
  kind     String // counter, tablet, host
  offline  Boolean  @default(false)
  quota    Json     @default("{}")
  lastSeen DateTime @default(now())
}

model OfflineOp {
  id          String   @id
  tenantId    String
  deviceId    String
  kind        String
  payload     Json
  baseVersion Int
  status      String // pending, posted, conflict, resolved
  conflict    Json?
  resolution  String?
  createdAt   DateTime
  receivedAt  DateTime @default(now())
}

model Campaign {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  template  String
  audience  Int
  status    String // draft, scheduled, sent
  message   String? // store update text, sent as body variable 2
  createdAt DateTime @default(now())
}

/// One row per AI question, kept for a minute: a sliding-window rate limit shared by every app instance.
model AiAsk {
  id     BigInt   @id @default(autoincrement())
  userId String
  at     DateTime @default(now())

  @@index([userId, at])
}

model AiConfirmation {
  token     String    @id
  tenantId  String
  userId    String
  tool      String
  inputHash String
  input     Json
  preview   Json
  expiresAt DateTime
  usedAt    DateTime?
}

// The pharmacy's copy of its Medoro licence. Fields below `licenceToken` come from the last licence
// document the licence server signed (see src/domain/system/licence.ts).
/// Subscription payments taken online on a hosted server (Razorpay Checkout), one row per order.
model OnlinePayment {
  id            String    @id @default(uuid())
  tenantId      String
  provider      String    @default("razorpay")
  orderId       String    @unique
  paymentId     String?   @unique
  plan          String // product id: starter, pro, multi
  cycle         String // m (month) or y (year)
  amountPaise   Int // total charged, including GST
  gstPaise      Int
  status        String    @default("created") // created, paid, failed, refunded, duplicate (paid twice; refunded automatically)
  periodFrom    DateTime?
  periodTo      DateTime?
  couponCode    String?
  discountPaise Int       @default(0) // coupon discount, off the GST-inclusive list price
  note          String? // why a payment failed, or was refunded
  prevStatus    String? // the plan's status and paid-until before this payment, to undo it on a refund
  prevRenewsAt  DateTime?
  refundId      String?
  refundedAt    DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([tenantId, createdAt])
}

/// Online payments to Medoro (the licence server) from self-hosted and desktop installations, one row per Razorpay order.
model CpOnlinePayment {
  id            String    @id @default(uuid())
  customerId    String
  orderId       String    @unique
  paymentId     String?   @unique
  plan          String // starter, pro, multi
  cycle         String // m, y
  amountPaise   Int // charged, GST included
  gstPaise      Int
  couponCode    String?
  discountPaise Int       @default(0)
  status        String    @default("created") // created, paid, failed, duplicate (refunded)
  note          String?
  refundId      String?
  saleId        String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([customerId, createdAt])
}

/// Subscription coupon codes, made in the staff console and entered by pharmacies before paying online.
model Coupon {
  id         String    @id @default(uuid())
  code       String    @unique // upper case, e.g. LAUNCH20
  percentOff Int // 1 to 100; 0 when payPaise sets a fixed price
  payPaise   Int? // fixed price to pay, GST included (e.g. 100 = ₹1 for testing); overrides percentOff
  plans      String[]  @default([]) // product ids it applies to; empty = every plan
  maxUses    Int? // null = unlimited
  uses       Int       @default(0) // paid orders that used it
  expiresAt  DateTime? // last moment it can be used
  active     Boolean   @default(true)
  note       String?
  createdBy  String
  createdAt  DateTime  @default(now())
}

model SubscriptionMeta {
  tenantId      String    @id
  plan          String
  addons        String[]
  status        String // trial, active, grace, cancelled (as issued)
  renewsAt      DateTime? // trial end or paid-until
  aiUntil       DateTime? // AI Pharmacy Manager add-on paid until (hosted servers that take payments themselves)
  graceUntil    DateTime?
  licenceToken  String? // sealed instance token used to sign check-ins
  licenceId     String?
  graceDays     Int       @default(7)
  signedDoc     String? // the last verified licence document, as received
  issuedAt      DateTime?
  checkedAt     DateTime? // last check-in attempt
  checkError    String?
  inbox         Json      @default("{}") // invoices, billing events, tickets and support requests from Medoro
  supportSeenAt DateTime?
}

// Requests to Medoro (tickets, add-on and plan changes, payment claims, support-access answers),
// sent immediately when possible and otherwise with the next licence check-in.
model LicenceOutbox {
  id        String    @id @default(uuid())
  tenantId  String
  kind      String
  payload   Json
  createdBy String
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  result    Json?

  @@index([tenantId, sentAt])
}

// One pending SMS code per phone: hashed, 5-minute expiry, 5 attempts.
model OtpCode {
  phone     String   @id
  codeHash  String
  purpose   String // signin, invite
  attempts  Int      @default(0)
  expiresAt DateTime
}

// ───────────────────────── Medoro control plane (staff console) ─────────────────────────
// Medoro's own records: staff, sales pipeline, commission, customer accounts and support.
// Nothing here links to pharmacy tables; staff code never reads them.

enum StaffRole {
  super_admin
  sales
  care
  partner // reference partner: an outside MR or consultant who refers pharmacies for commission
}

enum StaffStatus {
  invited
  pending
  active
  deactivated
}

model StaffUser {
  id              String         @id @default(uuid())
  empNo           String         @unique
  name            String
  email           String
  kind            String         @default("team") // team (Medoro employees) or partner: one email can have one of each
  phone           String
  role            StaffRole
  team            String         @default("")
  status          StaffStatus
  passwordHash    String?
  totpSecret      String? // sealed
  totpEnabled     Boolean        @default(false)
  referralCode    String?        @unique
  googleSub       String?        @unique // reference partners can sign in with Google
  bonusPct        Decimal        @default(0) @db.Decimal(5, 2)
  inviteTokenHash String?        @unique
  inviteExpiresAt DateTime?
  tokenVersion    Int            @default(0)
  approvedBy      String?
  createdAt       DateTime       @default(now())
  sessions        StaffSession[]
  bank            StaffBank?

  @@unique([email, kind])
}

model StaffSession {
  id           String    @id // sha256 of the cookie token
  staffId      String
  staff        StaffUser @relation(fields: [staffId], references: [id])
  tokenVersion Int
  mfaPassed    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  ip           String?
  userAgent    String?
}

model StaffBank {
  staffId          String    @id
  staff            StaffUser @relation(fields: [staffId], references: [id])
  holder           String
  accountSealed    String
  last4            String
  ifsc             String
  bank             String
  type             String
  panSealed        String
  panMasked        String
  status           String // pending, verified
  addedAt          DateTime  @default(now())
  verifiedAt       DateTime?
  verifiedBy       String?
  rzpFundAccountId String? // RazorpayX fund account for this bank account; cleared when it changes
}

/**
 * A payment of commission to a sales person or reference partner, by RazorpayX payout or a recorded bank transfer.
 */
model StaffPayout {
  id          String   @id @default(uuid())
  ref         String   @unique
  staffId     String
  grossPaise  Int
  tdsPaise    Int
  netPaise    Int
  saleIds     String[]
  method      String // razorpay, manual
  rzpPayoutId String?  @unique
  status      String // processing, paid, failed
  utr         String?
  failure     String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([staffId, createdAt])
}

model StaffAudit {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  staffId   String?
  staffName String
  action    String
  detail    String?
  ip        String?
}

model CpSetting {
  key   String @id
  value Json
}

model CpCustomer {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  owner        String
  phone        String           @unique // 10 digits
  email        String           @default("")
  city         String           @default("")
  address      String           @default("")
  gstin        String           @default("")
  drugLicence  String           @default("")
  product      String // starter, pro, multi
  addons       String[]
  cycle        String // m, y
  status       String // trial, active, grace, cancelled
  since        DateTime         @db.Date
  renewsOn     DateTime?        @db.Date
  branches     Int              @default(1)
  devices      Int              @default(1)
  deployment   String           @default("")
  lastCheckIn  DateTime?
  appVersion   String?
  salesStaffId String?
  createdAt    DateTime         @default(now())
  licenceId    String?          @unique
  licenceToken String? // sealed; the instance signs check-ins with it
  graceDays    Int              @default(7)
  notes        CpNote[]
  tickets      Ticket[]
  billing      CpBillingEvent[]
}

// Billing history per customer: invoices, payment claims from the app, add-on/cancel requests, trial extensions.
model CpBillingEvent {
  id          String     @id @default(uuid())
  customerId  String
  customer    CpCustomer @relation(fields: [customerId], references: [id])
  kind        String // invoice, payment_claim, addon_add, addon_remove, cancel, trial_extended
  status      String // open, done, rejected
  number      String?    @unique // invoice number
  amountPaise Int        @default(0) // before GST
  gstPaise    Int        @default(0)
  reference   String?
  detail      String     @default("")
  saleId      String?
  requestId   String?    @unique // the pharmacy's outbox id, so a resend is not a duplicate
  byName      String
  createdAt   DateTime   @default(now())
  decidedAt   DateTime?
  decidedBy   String?
}

model CpNote {
  id         String     @id @default(uuid())
  customerId String
  customer   CpCustomer @relation(fields: [customerId], references: [id])
  text       String
  byName     String
  staffId    String
  at         DateTime   @default(now())
}

model Lead {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  owner          String
  phone          String    @unique // 10 digits
  city           String
  source         String
  product        String
  stage          String // new, contacted, demo, trial, won, lost
  nextOn         DateTime? @db.Date
  staffId        String
  lostReason     String?
  discountPct    Int?
  discountStatus String? // pending, approved, rejected
  email          String    @default("")
  createdAt      DateTime  @default(now())
  logs           LeadLog[]
}

model LeadLog {
  id      String   @id @default(uuid())
  leadId  String
  lead    Lead     @relation(fields: [leadId], references: [id])
  text    String
  staffId String
  at      DateTime @default(now())
}

model CpSale {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  pharmacy        String
  phone           String
  city            String    @default("")
  customerId      String?
  product         String
  cycle           String // m, y
  type            String // new, renewal
  staffId         String
  status          String // pending, verified, paid, rejected
  amountPaise     Int // before GST
  ratePct         Decimal   @db.Decimal(5, 2)
  commissionPaise Int
  leadId          String?
  verifiedBy      String?
  verifiedAt      DateTime?
  paidAt          DateTime?
  payoutRef       String?
  payRef          String? // UPI/bank reference the pharmacy entered in its app
  createdAt       DateTime  @default(now())
}

model Ticket {
  id               String          @id @default(uuid())
  code             String          @unique
  customerId       String
  customer         CpCustomer      @relation(fields: [customerId], references: [id])
  subject          String
  category         String          @default("General")
  channel          String          @default("Phone")
  priority         String // high, medium, low
  status           String // open, waiting, resolved
  assigneeId       String?
  escalatedTo      String?
  createdAt        DateTime        @default(now())
  firstResponseDue DateTime
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  messages         TicketMessage[]
}

model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  text         String
  byName       String
  staffId      String?
  internal     Boolean  @default(false)
  fromCustomer Boolean  @default(false)
  at           DateTime @default(now())
}

model RemoteAccessRequest {
  id          String    @id @default(uuid())
  customerId  String
  staffId     String
  ticketId    String?
  status      String // requested, approved, denied, expired
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  expiresAt   DateTime?
  link        String? // sealed single-use support link the owner approved with
}

// A restore from backup: loaded into a test copy (a separate schema) first, applied to live only after the owner confirms.
model RestoreRun {
  id             String    @id @default(uuid())
  tenantId       String
  manifestId     String
  schemaName     String // e.g. restore_ab12cd34; dropped after apply or discard
  status         String // prepared, applied, discarded, failed
  summary        Json // per-table counts, backup vs live, and key figures
  createdBy      String
  createdAt      DateTime  @default(now())
  appliedAt      DateTime?
  appliedBy      String?
  safetyBackupId String?
  error          String?
}

// Time-limited, read-only access the owner grants to Medoro support. The link works once.
model SupportGrant {
  id          String    @id @default(uuid())
  tenantId    String
  tokenHash   String    @unique
  reason      String
  minutes     Int
  createdById String
  createdBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedIp      String?
  revokedAt   DateTime?
  revokedBy   String?
}

/// IRP and e-way bill results, append-only. The latest row of a kind for a document wins; a cancellation is a new row.
model EInvoice {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  docType   String // sale, transfer
  docId     String
  docNo     String
  kind      String // irn, irn_cancel, ewb
  irn       String?
  ackNo     String?
  ackDt     String?
  signedQr  String?
  signedInv String?
  ewbNo     String?
  ewbDate   String?
  ewbValid  String?
  request   Json
  response  Json
  userId    String
  at        DateTime @default(now())

  @@index([tenantId, docType, docId])
}

/// Files kept in the database (invoice scans, encrypted backups) when the host has no persistent disk
/// and no object storage is configured. Key: "<tenantId>/<kind>/<file>".
model FileObject {
  key         String   @id
  tenantId    String
  contentType String
  bytes       Bytes? // null when the file is kept in the pharmacy's Google Drive
  driveFileId String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

/// A same-day void of a whole sale. Append-only; the sale itself is never changed.
model SaleVoid {
  id              String   @id @default(uuid())
  tenantId        String
  branchId        String
  saleId          String   @unique
  sale            Sale     @relation(fields: [saleId], references: [id])
  reason          String
  userId          String
  shiftId         String?
  /// Refunds per payment mode: [{ mode, amountPaise }]
  refunds         Json
  cashRefundPaise BigInt   @default(0)
  at              DateTime @default(now())

  @@index([tenantId, branchId, at])
}

/// A manager's on-the-spot approval of a discount above the cashier's cap: single use, bound to the cart.
model DiscountApproval {
  id          String    @id @default(uuid())
  tenantId    String
  branchId    String
  tokenHash   String    @unique
  requestedBy String
  approvedBy  String
  discountPct Decimal
  cartHash    String
  totalPaise  BigInt
  expiresAt   DateTime
  usedAt      DateTime?
  saleId      String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
}

// ───────────── Orders & home delivery ─────────────

enum OrderStatus {
  new
  confirmed
  packed
  out_for_delivery
  delivered
  cancelled
  returned
}

/// A customer order (phone, WhatsApp or counter) delivered to an address. Packing bills it as a normal sale.
model DeliveryOrder {
  id             String              @id @default(uuid())
  tenantId       String
  branchId       String
  no             String
  source         String // phone, whatsapp, walk_in
  customerId     String?
  name           String
  phone          String
  address        String
  slotDate       DateTime?           @db.Date
  slot           String?
  notes          String?
  payMode        String // cod, prepaid, credit
  payRef         String?
  discountPct    Decimal             @default(0)
  prescriber     String?
  prescriberReg  String? // Schedule H1, X and NDPS items: prescriber's registration number
  rxPath         String?
  rxMime         String?
  waConsent      Boolean             @default(false)
  status         OrderStatus         @default(new)
  estimatePaise  BigInt              @default(0)
  saleId         String?             @unique
  invoiceNo      String?
  totalPaise     BigInt?
  riderId        String?
  otpHash        String?
  otpAttempts    Int                 @default(0)
  proof          String? // otp, signature
  receivedBy     String?
  collectedPaise BigInt              @default(0)
  collectedMode  String? // cash, upi
  settlementId   String?
  reason         String? // cancel/return reason, or the last failed delivery attempt
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deliveredAt    DateTime?
  items          DeliveryOrderItem[]

  @@unique([tenantId, no])
  @@index([tenantId, branchId, status])
  @@index([tenantId, riderId, status])
}

model DeliveryOrderItem {
  id         String        @id @default(uuid())
  orderId    String
  order      DeliveryOrder @relation(fields: [orderId], references: [id])
  medicineId String
  qty        Int
}

/// Order history: every status change, failed attempt and customer notification. Append-only.
model DeliveryEvent {
  id       String   @id @default(uuid())
  tenantId String
  branchId String
  orderId  String
  kind     String // a status, attempt_failed, notified, rx_uploaded, rider_assigned
  note     String?
  userId   String?
  userName String?
  at       DateTime @default(now())

  @@index([orderId, at])
}

/// Cash on delivery handed over by a delivery person at the counter. Append-only.
model RiderSettlement {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  no            String
  riderId       String
  orderIds      String[]
  expectedPaise BigInt
  countedPaise  BigInt
  shiftId       String?
  userId        String
  note          String?
  at            DateTime @default(now())

  @@unique([tenantId, no])
  @@index([tenantId, branchId, at])
}

/// Loyalty points, one row per change; a balance is the sum of points. Append-only.
model LoyaltyLedger {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  kind       String // earn, redeem, reverse, restore, expire
  points     Int
  valuePaise BigInt    @default(0) // redeem/restore: rupee value at the sale's point rate
  saleId     String?
  returnId   String?
  expiresAt  DateTime?
  note       String?
  userId     String?
  at         DateTime  @default(now())

  @@index([tenantId, customerId])
  @@index([saleId])
}

/// DriveDB (Drive mode): a device allowed to sync this pharmacy's encrypted data through Medoro's relay.
/// Only its public key and status live here; the data and keys are in the owner's Google Drive.
model DriveDevice {
  id        String    @id @default(uuid())
  tenantId  String
  deviceId  String
  userId    String
  name      String
  role      String // owner | staff
  status    String    @default("pending") // pending | approved | removed
  publicKey Json
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  lastSeen  DateTime?
  lastSyncAt  DateTime? // last sync with Google Drive that worked
  lastError   String? // the device's last sync error (text only), cleared by the next good sync
  lastErrorAt DateTime?

  @@unique([tenantId, deviceId])
  @@index([tenantId, status])
}
