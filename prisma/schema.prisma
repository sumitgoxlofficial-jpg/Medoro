  RESEARCH_PENDING
  QUALIFIED
  ASSIGNED
  CONTACT_PERMISSION_PENDING
  CONTACT_AUTHORIZED
  FIRST_CONTACT
  INTERESTED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  TRIAL_STARTED
  NEGOTIATION
  CONVERTED
  LOST
  FOLLOW_UP_LATER
  DO_NOT_CONTACT
