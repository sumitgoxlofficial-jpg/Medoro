model Integration {
  id              String    @id @default(uuid())
  tenantId        String
  kind            String // whatsapp, gdrive
  config          Json
  encryptedSecret Bytes?
  connectedAt     DateTime?
  rotatedAt       DateTime?

  @@unique([tenantId, kind])
}

model BackupManifest {
