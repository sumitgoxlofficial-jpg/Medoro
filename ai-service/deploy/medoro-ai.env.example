# /etc/medoro-ai.env  (chmod 600, owner root). Generate the token with: openssl rand -hex 32
# Defaults suit an 8 GB, CPU-only Ubuntu host shared with Ollama. Measured numbers: docs/ai-hr-assistant/TEST-REPORT.md.
MEDORO_AI_TOKEN=

# ── Naina's voice: Kokoro-82M (Apache-2.0), self-hosted
TTS_ENGINE=kokoro
KOKORO_MODEL=hexgrad/Kokoro-82M
KOKORO_LANG=h
KOKORO_VOICE=hf_alpha
# English replies: same_voice (Naina's Hindi voice reads English) or english_voice (Kokoro English pipeline + KOKORO_EN_VOICE)
KOKORO_EN_MODE=same_voice
KOKORO_EN_VOICE=bf_emma
TTS_SPEED=0.95
TTS_PAUSE_MS=260
TTS_CHUNK_CHARS=160
TTS_THREADS=2
TTS_CONCURRENCY=1
TTS_QUEUE_MAX=8
TTS_TIMEOUT_S=60
TTS_CACHE_SIZE=100
TTS_CACHE_MB=48
TTS_WARM=1
# HR's pronunciation fixes (JSON, re-read when it changes): {"terms": {...}, "names": {...}, "words": {...}}
TTS_LEXICON_PATH=/etc/medoro-ai/lexicon.json
# Model files live here (outside the Git checkout). After the first download nothing is fetched again.
HF_HOME=/opt/medoro-ai/cache/huggingface
HF_HUB_OFFLINE=1

# ── CPU threads (torch, CTranslate2) and memory: fewer glibc arenas keeps torch's resident memory down
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
MALLOC_ARENA_MAX=2

# ── Speech to text (only when HR chooses "Our AI host" for recognition; browsers do it by default)
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_THREADS=2
WHISPER_LANGUAGE=

# ── Local model for intent classification
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=medoro-hr

# ── Rollback only (TTS_ENGINE=piper): needs requirements-piper-rollback.txt and a voice you are licensed to use.
# The hi_IN-priyamvada voice is non-commercial: do not point this at it for commercial use.
PIPER_VOICE=
