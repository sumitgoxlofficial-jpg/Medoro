# /etc/systemd/system/medoro-ai.service
[Unit]
Description=Medoro AI service (Faster-Whisper, Piper, Ollama client)
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=medoro-ai
Group=medoro-ai
WorkingDirectory=/opt/medoro-ai/service
EnvironmentFile=/etc/medoro-ai.env
ExecStart=/opt/medoro-ai/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090 --workers 1 --no-access-log
Restart=always
RestartSec=5
# An 8 GB host shared with Ollama: keep this process bounded and restart it rather than let it swap the box.
MemoryMax=3G
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/medoro-ai/cache
Environment=HF_HOME=/opt/medoro-ai/cache/huggingface

[Install]
WantedBy=multi-user.target
