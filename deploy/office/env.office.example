# .env.office: settings and secrets for the office server (copy to the repository root as .env.office; never commit it).
# scripts/office/setup.sh writes this for you. Everything not listed here can be copied from your Vercel project's
# environment variables unchanged (mail, WhatsApp, Google sign-in, Razorpay, licence keys, STAFF_* …).

NODE_ENV=production
TZ=Asia/Kolkata
APP_URL=https://medoro.in                 # the public address the tunnel serves
DEPLOYMENT_MODE=cloud

# Database. Either Supabase (keep your current data):
DATABASE_URL=                             # Supabase "Transaction pooler" URL (port 6543), same as in Vercel
DIRECT_URL=                               # Supabase "Direct"/"Session" URL (port 5432), same as in Vercel
DATABASE_MIGRATOR_URL=                    # usually the same as DIRECT_URL (migrations can't run through the pooler)
# …or a database on this machine (compose.localdb.yml sets the URLs itself):
POSTGRES_PASSWORD=                        # letters and digits only

# MUST be the same values as on Vercel when you keep the Supabase data: HOST_KEY decrypts bank accounts, KYC numbers,
# chat messages and AI transcripts. A different key makes them unreadable. Only a brand-new install may generate new ones.
SESSION_SECRET=
HOST_KEY=
CRON_SECRET=

# Behind the Cloudflare Tunnel: take the visitor's address from Cloudflare.
TRUST_PROXY=cloudflare
CLOUDFLARE_TUNNEL_TOKEN=                  # Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token

# Optional: server voice for the AI HR Assistant (profile "ai"); the free in-browser voice needs none of this.
AI_HR_SERVICE_URL=                        # http://ai-service:8090 when the "ai" profile runs on this machine
AI_HR_SERVICE_TOKEN=

# Optional: let office PCs open the app directly at http://<this-pc>:3000 (otherwise only through the domain).
# MEDORO_HTTP_BIND=0.0.0.0
