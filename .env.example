# Medoro — example configuration. Copy to .env and fill in. NEVER commit real values.

# --- Core ---
NODE_ENV=production
APP_URL=https://pharmacy.example.in
TZ=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEPLOYMENT_MODE=lan            # cloud | onprem | lan | single
STRICT_CUSTOMER_MODE=true

# --- Database (customer-controlled) ---
DATABASE_URL=postgresql://medoro_app:CHANGE_ME@127.0.0.1:5432/medoro?sslmode=require
DATABASE_MIGRATOR_URL=postgresql://medoro_migrator:CHANGE_ME@127.0.0.1:5432/medoro?sslmode=require

# --- Hosted deployment (Vercel + Supabase); see docs/VERCEL_SUPABASE.md ---
# DATABASE_URL above = Supabase transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=                     # Supabase session pooler (port 5432): migrations and live updates
SUPABASE_URL=                   # https://<project-ref>.supabase.co (server only)
SUPABASE_SECRET_KEY=            # Supabase secret key (sb_secret_...). Server only: never NEXT_PUBLIC_
SUPABASE_STORAGE_BUCKET=medoro-private
CRON_SECRET=                    # >= 16 random characters; Vercel Cron sends it to /api/cron/tick
SETUP_TOKEN=                    # required before first-run setup opens on a public server
SEED_DEMO=                      # 1 enables POST /api/seed-demo (needs SETUP_TOKEN; only on an empty install). Leave blank in production

# --- Sessions & crypto ---
SESSION_SECRET=                 # >= 32 random bytes, base64
HOST_KEY=                       # REQUIRED in production: >= 32 random chars, different from SESSION_SECRET. Seals integration
                                # secrets, the backup key and authenticator secrets; keep a copy offline (see docs/DEPLOYMENT.md)
TRUST_PROXY=                    # 1 only behind your own reverse proxy that sets X-Forwarded-For (not needed on Vercel); used for sign-in throttling and audit IPs
OTP_PROVIDER=                   # SMS gateway id; blank disables mobile OTP. "console" logs codes (local dev only)
OTP_API_KEY=

# --- Licence (Medoro control plane) ---
# The licence server is the staff console of Medoro's own deployment. Leave LICENSE_SERVER_URL blank for a
# pure self-hosted or development install: nothing is limited and no check-ins are sent. When it is set, the
# install registers on first check-in (14-day trial from setup), then checks in hourly (in-process scheduler)
# or daily (host cron), and on opening Subscription, Help or Privacy. Medoro support can also issue a licence
# key ("MEDORO-...") that the owner enters under Subscription; it is stored sealed in the database.
LICENSE_SERVER_URL=             # e.g. https://app.medoro.in (the deployment that runs /staff)
LICENSE_PUBLIC_KEY=             # Ed25519 public key (base64 SPKI DER) that verifies signed licences; required when LICENSE_SERVER_URL is set
# Only on Medoro's own deployment (the licence server). Generate both keys with: node scripts/licence-keys.mjs
LICENSE_SIGNING_KEY=            # Ed25519 private key (base64 PKCS#8 DER). Never on pharmacy servers
# Payment instructions shown on the Subscription page ("Renew or pay"). Payments are reported in the app and verified in /staff.
PAYMENT_UPI_ID=                 # e.g. medoro@hdfcbank; the page shows a UPI QR with the amount and reference
PAYMENT_PAYEE=Medoro            # name shown with the UPI ID
PAYMENT_BANK=                   # optional bank transfer details, e.g. "Medoro Pvt Ltd · A/c 50200012345678 · IFSC HDFC0001234"

# --- WhatsApp Cloud API (stored encrypted after onboarding; these are bootstrap only) ---
WA_APP_ID=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0

# --- Google Drive backups ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://pharmacy.example.in/api/integrations/google/callback
BACKUP_SCHEDULE_CRON=30 2 * * *
BACKUP_RETENTION_DAYS=30

# --- AI ---
AI_ENABLED=true
AI_MODE=local                   # local | remote
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=
REMOTE_AI_PROVIDER=             # only used when AI_MODE=remote and owner opted in
REMOTE_AI_API_KEY=

# --- OCR ---
OCR_ENGINE=local                # local | remote
OCR_REMOTE_URL=
OCR_REMOTE_KEY=

# --- Observability (privacy-preserving) ---
TELEMETRY_ENABLED=false
CRASH_REPORTS_ENABLED=false
LOG_LEVEL=info

# --- Medoro staff console (/staff) ---
# Only for Medoro's own deployment. The first person to sign up with this email
# becomes the first super admin; everyone else waits for approval.
STAFF_EMAIL_DOMAIN=medoro.in
STAFF_BOOTSTRAP_EMAIL=
