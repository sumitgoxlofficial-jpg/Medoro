# Medoro — example configuration. Copy to .env and fill in. NEVER commit real values.

# --- Core ---
NODE_ENV=production
APP_URL=https://pharmacy.example.in
TZ=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEPLOYMENT_MODE=lan            # cloud | onprem | lan | single
STRICT_CUSTOMER_MODE=true

# --- Database (customer-controlled) ---
DATABASE_URL=postgresql://medoro_app:CHANGE_ME@127.0.0.1:5432/medoro?sslmode=require
DATABASE_MIGRATOR_URL=postgresql://medoro_migrator:CHANGE_ME@127.0.0.1:5432/medoro?sslmode=require

# --- Hosted deployment (Vercel + Supabase); see docs/VERCEL_SUPABASE.md ---
# DATABASE_URL above = Supabase transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=                     # Supabase session pooler (port 5432): migrations and live updates
SUPABASE_URL=                   # https://<project-ref>.supabase.co (server only)
SUPABASE_SECRET_KEY=            # Supabase secret key (sb_secret_...). Server only: never NEXT_PUBLIC_
SUPABASE_STORAGE_BUCKET=medoro-private
CRON_SECRET=                    # >= 16 random characters; Vercel Cron sends it to /api/cron/tick
SETUP_TOKEN=                    # required before first-run setup opens on a public server
SEED_DEMO=                      # 1 enables POST /api/seed-demo (needs SETUP_TOKEN; only on an empty install). Leave blank in production

# --- Sessions & crypto ---
SESSION_SECRET=                 # >= 32 random bytes, base64
HOST_KEY=                       # REQUIRED in production: >= 32 random chars, different from SESSION_SECRET. Seals integration
                                # secrets, the backup key and authenticator secrets; keep a copy offline (see docs/DEPLOYMENT.md)
TRUST_PROXY=                    # 1 only behind your own reverse proxy that sets X-Forwarded-For (not needed on Vercel); used for sign-in throttling and audit IPs
SESSION_IDLE_MINUTES=120        # owner/manager sessions end after this much inactivity (counter sessions last the 12 h shift)

# --- Sign-in providers (each optional; see "Sign-in providers" in docs/SECURITY.md) ---
# SMS codes: mobile OTP sign-in, employee invites, password reset and lost-authenticator recovery.
OTP_PROVIDER=                   # msg91 | twilio | http | console (console logs codes; refused in production). Blank disables SMS
OTP_API_KEY=                    # msg91: account auth key
OTP_TEMPLATE_ID=                # msg91: DLT-approved Flow template id; the template text must contain ##otp## (and may use ##minutes##)
OTP_SENDER=                     # msg91: 6-letter DLT sender id (optional when set on the template)
TWILIO_ACCOUNT_SID=             # twilio: ACxxxxxxxx
TWILIO_AUTH_TOKEN=              # twilio: auth token
TWILIO_FROM=                    # twilio: sender number in E.164 (+1...) or a Messaging Service SID (MG...)
OTP_HTTP_URL=                   # http: your HTTPS webhook; receives POST {phone (+91...), code, purpose, text}
OTP_HTTP_TOKEN=                 # http: sent as "Authorization: Bearer <token>"
# Order updates by SMS (Orders & delivery). Defaults to OTP_PROVIDER and its credentials.
SMS_PROVIDER=                   # msg91 | twilio | http | console; blank = same as OTP_PROVIDER
SMS_TEMPLATE_ID=                # msg91: a DLT-approved Flow template with a ##text## variable (the OTP template can't carry order text)
SMS_HTTP_URL=                   # http: webhook for order messages (default OTP_HTTP_URL); receives POST {phone, purpose: "message", text}
SMS_HTTP_TOKEN=                 # http: bearer token for SMS_HTTP_URL
# Email: password reset, lost-authenticator codes and scheduled report emails (with CSV attachments).
MAIL_PROVIDER=                  # resend | sendgrid | http (alias smtp-http) | console (logs mail; refused in production). Blank disables email
MAIL_FROM=                      # e.g. Medoro <no-reply@pharmacy.example.in>; the domain must be verified with your provider
RESEND_API_KEY=                 # resend: re_...
SENDGRID_API_KEY=               # sendgrid: SG....
MAIL_HTTP_URL=                  # http: your HTTPS relay; receives POST {from, to, subject, text, attachments?: [{filename, contentType, content (base64)}]}
MAIL_HTTP_TOKEN=                # http: sent as "Authorization: Bearer <token>"
# "Sign in with Google" uses GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET below (same client as Drive backups).
GOOGLE_LOGIN_REDIRECT_URI=      # default ${APP_URL}/api/auth/google/callback; must be listed exactly in the Google client's redirect URIs

# --- Licence (Medoro control plane) ---
LICENSE_SERVER_URL=https://licence.medoro.in
LICENSE_PUBLIC_KEY=             # Ed25519 public key for offline verification
TENANT_ID=

# --- WhatsApp Cloud API (stored encrypted after onboarding; these are bootstrap only) ---
WA_APP_ID=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0

# --- Google OAuth client: Drive backups and "Sign in with Google" (leave blank to hide both) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://pharmacy.example.in/api/integrations/google/callback
BACKUP_SCHEDULE_CRON=30 2 * * *
BACKUP_RETENTION_DAYS=30

# --- AI ---
AI_ENABLED=true
AI_MODE=local                   # local | remote
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=
REMOTE_AI_PROVIDER=             # only used when AI_MODE=remote and owner opted in
REMOTE_AI_API_KEY=

# --- OCR ---
OCR_ENGINE=local                # local | remote
OCR_REMOTE_URL=
OCR_REMOTE_KEY=

# --- Observability (privacy-preserving) ---
TELEMETRY_ENABLED=false
CRASH_REPORTS_ENABLED=false
LOG_LEVEL=info

# --- Medoro staff console (/staff) ---
# Only for Medoro's own deployment. The first person to sign up with this email
# becomes the first super admin; everyone else waits for approval.
STAFF_EMAIL_DOMAIN=medoro.in
STAFF_BOOTSTRAP_EMAIL=
